;-------------------------------------------------
;Ｇスポット刺激実行判定
;-------------------------------------------------
@COMABLE_[[TRAIN:Ｇスポット刺激]]
#FUNCTION
    ;Ｇスポット刺激実行判定
    RESULT = COMABLE_DEF([[TRAIN:Ｇスポット刺激]]) && COND("指の使用", PLAYER)    
    RETURNF RESULT && MPLY_NUM == 1 && MTAR_NUM == 1


;-------------------------------------------------
;調教時メッセージ
;-------------------------------------------------
@TRAIN_MESSAGE_COM_[[TRAIN:Ｇスポット刺激]]
    PRINTFORM %CALLNAME:PLAYER%は、%CALLNAME:TARGET%の
    ;着衣設定
    IF CFLAG:着衣状態 & 8 && ABL:露出癖 != 0
        PRINT まとっている
        CALL PRINT_上着タイプ(TARGET)
        PRINT の裾をめくり上げ、
    ENDIF
    IF EXP:Ｖ経験 == 0
        PRINT 男を知らない
    ELSEIF PALAM:潤滑 >= PALAMLV:4
        PRINT 濡れそぼった
    ENDIF
    IF TALENT:幼稚
        PRINT 幼いワレメ
    ELSE
        PRINT 秘裂
    ENDIF
    IF TEQUIP:バイブ
        PRINTFORML の中で、妖しくうねるバイブを前後に抜き差しした
    ELSE
        PRINTFORML に自分の指を挿し入れて優しく動かしている…
    ENDIF
    ;Gスポット刺激
    IF TEQUIP:バイブ
        PRINTFORML %CALLNAME:PLAYER%は巧みにバイブを操り、敏感な天井をなぶった…
    ELSE
        PRINTFORML %CALLNAME:PLAYER%は%CALLNAME:TARGET%の膣の中で指を曲げ、ザラついた天井を刺激した…
    ENDIF


;-------------------------------------------------
;ソースの計算
;ARG:100％倍率
;-------------------------------------------------
@CALC_SOURCE_COM_[[TRAIN:Ｇスポット刺激]](ARG=100)

    ;快Ｖのソース
    TMP_SRC:TARGET:快Ｖ += CALC_刺激SOURCE("Ｖ刺激", TARGET, 刺激_緩やか)
    ;情愛のソース
    TMP_SRC:TARGET:屈従 += 10 * POWER(ABL:Ｖ感覚 + 1, 2)

    ;EXP:Ｖ経験をみる
    SELECTCASE GETEXPLV(EXP:Ｖ経験, 5)
        CASE 0
            TIMES TMP_SRC:TARGET:快Ｖ, 0.20
            TIMES TMP_SRC:TARGET:屈従, 0.20
            TMP_SRC:TARGET:痛覚 += 150
        CASE 1
            TIMES TMP_SRC:TARGET:快Ｖ, 0.50
            TIMES TMP_SRC:TARGET:屈従, 0.50
            TMP_SRC:TARGET:痛覚 += 80
        CASE 2
            TIMES TMP_SRC:TARGET:快Ｖ , 1.00
            TIMES TMP_SRC:TARGET:屈従, 0.80
            TMP_SRC:TARGET:痛覚 += 50
        CASE 3
            TIMES TMP_SRC:TARGET:快Ｖ , 1.20
            TIMES TMP_SRC:TARGET:屈従, 1.00
            TMP_SRC:TARGET:痛覚 += 0
        CASE 4
            TIMES TMP_SRC:TARGET:快Ｖ , 1.60
            TIMES TMP_SRC:TARGET:屈従, 1.20
            TMP_SRC:TARGET:痛覚 += 0
        CASEELSE
            TIMES TMP_SRC:TARGET:快Ａ , 1.80
            TIMES TMP_SRC:TARGET:屈従, 1.50
            TMP_SRC:TARGET:痛覚 += 0
    ENDSELECT

    ;PALAM:潤滑をみる
    SELECTCASE GETPALAMLV(PALAM:潤滑 , 4)
        CASE 0
            TIMES TMP_SRC:TARGET:快Ｖ , 0.10
            TMP_SRC:TARGET:痛覚 += 2000
            TIMES TMP_SRC:TARGET:痛覚 , 3.00
        CASE 1
            TIMES TMP_SRC:TARGET:快Ｖ , 0.20
            TMP_SRC:TARGET:痛覚 += 800
            TIMES TMP_SRC:TARGET:痛覚 , 1.00
        CASE 2
            TIMES TMP_SRC:TARGET:快Ｖ , 0.60
            TIMES TMP_SRC:TARGET:痛覚 , 0.80
        CASE 3
            TIMES TMP_SRC:TARGET:快Ｖ , 1.00
            TIMES TMP_SRC:TARGET:痛覚 , 0.50
        CASEELSE
            TIMES TMP_SRC:TARGET:快Ｖ , 2.00
            TIMES TMP_SRC:TARGET:痛覚 , 0.10
    ENDSELECT

    ;PALAM:欲情をみる
    SELECTCASE GETPALAMLV(PALAM:欲情 , 4)
        CASE 0
            TIMES TMP_SRC:TARGET:快Ｖ , 1.50
            TIMES TMP_SRC:TARGET:充足 , 0.90
            TIMES TMP_SRC:TARGET:愛液分泌 , 0.90
        CASE 1
            TIMES TMP_SRC:TARGET:快Ｖ , 1.80
            TIMES TMP_SRC:TARGET:充足 , 1.00
            TIMES TMP_SRC:TARGET:愛液分泌 , 1.00
        CASE 2
            TIMES TMP_SRC:TARGET:快Ｖ , 2.10
            TIMES TMP_SRC:TARGET:充足 , 1.10
            TIMES TMP_SRC:TARGET:愛液分泌 , 1.10
        CASE 3
            TIMES TMP_SRC:TARGET:快Ｖ , 3.20
            TIMES TMP_SRC:TARGET:充足 , 1.20
            TIMES TMP_SRC:TARGET:愛液分泌 , 1.20
        CASEELSE
            TIMES TMP_SRC:TARGET:快Ｖ , 4.30
            TIMES TMP_SRC:TARGET:充足 , 1.30
            TIMES TMP_SRC:TARGET:愛液分泌 , 1.30
    ENDSELECT

    ;Ｖ敏感、鈍感をみる
    ;快Ｖ自体のチェックは後でまとめてやる
    IF IS_Ｖ鈍感(TARGET)
        TIMES TMP_SRC:TARGET:痛覚 , 0.60
        TIMES TMP_SRC:TARGET:屈従 , 0.60
        TIMES TMP_SRC:TARGET:逸脱 , 0.60
    ELSEIF IS_Ｖ敏感(TARGET)
        TIMES TMP_SRC:TARGET:痛覚 , 1.50
        TIMES TMP_SRC:TARGET:屈従 , 1.50
        TIMES TMP_SRC:TARGET:逸脱 , 1.50
    ENDIF

    ;処女で貞操観念
    SIF IS処女(TARGET) && IS_貞操観念(TARGET)
        TIMES TMP_SRC:TARGET:屈従 , 2.00
    ;未熟
    SIF TALENT:未熟
        TIMES TMP_SRC:TARGET:痛覚 , 2.00

    SIF IS_汚臭鈍感(TARGET)
        TMP_SRC:TARGET:不潔 += COM_汚れ(PLAYER,STNNUM("手"),STNNUM("ヴァギナ"),3,2) * 10 / 3
    SIF IS_汚臭敏感(TARGET)
        TMP_SRC:TARGET:不潔 += COM_汚れ(PLAYER,STNNUM("手"),STNNUM("ヴァギナ"),3,2) * 10 * 2

    ;調教者
    TMP_SRC:PLAYER:屈従 = 10
    SIF IS_FEMALE(TARGET) && IS_FEMALE(PLAYER) && !TALENT:PLAYER:両刀
        TMP_SRC:PLAYER:屈従 += 40

    TMP_SRC:PLAYER:逸脱 = 20
    SIF IS_汚臭鈍感(PLAYER)
        TMP_SRC:PLAYER:不潔 += COM_汚れ(TARGET,STNNUM("ヴァギナ"),STNNUM("手"),1,3) * 5 / 3
    SIF IS_汚臭敏感(PLAYER)
        TMP_SRC:PLAYER:不潔 += COM_汚れ(TARGET,STNNUM("ヴァギナ"),STNNUM("手"),1,3) * 5 * 2

    TMP_SRC:PLAYER:性行動 = 250 + MIN(ABL:PLAYER:奉仕精神, 5) * 50
    TEMP_NUM = 50 + MIN(ABL:PLAYER:奉仕精神, 5) * 50 + LIMIT(ABL:PLAYER:奉仕精神 - 1,0,4) * 50 + LIMIT(ABL:PLAYER:奉仕精神 - 3,0,2) * 100 + LIMIT(ABL:PLAYER:奉仕精神 - 4,0,1) * 100
    IF TEQUIP:PLAYER:奉仕
        TMP_SRC:PLAYER:屈従 += TEMP_NUM
        TMP_SRC:PLAYER:達成 += TEMP_NUM / 10
        TMP_SRC:TARGET:達成 += 10 + MIN(ABL:サドっ気, 5) * 10 + LIMIT(ABL:PLAYER:サドっ気 - 1,0,4) * 10 + LIMIT(ABL:PLAYER:サドっ気 - 3,0,2) * 20 + LIMIT(ABL:PLAYER:サドっ気 - 4,0,1) * 30
    ELSE
        TMP_SRC:PLAYER:達成 += TEMP_NUM
    ENDIF

	CALL APPLY_SOURCE_RATE(ARG)


;-------------------------------------------------
;経験上昇
;ARG:100％倍率
;-------------------------------------------------
@CALC_NOWEX_COM_[[TRAIN:Ｇスポット刺激]](ARG=100)
    NOWEX:体力変動 += 50
    NOWEX:気力変動 += 100

    ;レズ経験
    IF HAVE_VAGINA(TARGET) && HAVE_VAGINA(PLAYER) 
        NOWEX:レズ経験 = 5
        NOWEX:PLAYER:レズ経験 = 5
    ENDIF

    NOWEX:Ｖ経験 += 1

    ;愛情経験
    IF CFLAG:好感度 >= 1000 && PLAYER == MASTER
        NOWEX:愛情経験 += 2
    ELSEIF CFLAG:PLAYER:好感度 >= 1000 && TARGET == MASTER
        NOWEX:PLAYER:愛情経験 += 2
    ENDIF

	CALL APPLY_EX_RATE(ARG)

;-------------------------------------------------
;FLAGの計算
;-------------------------------------------------
@CALC_FLAG_COM_[[TRAIN:Ｇスポット刺激]]
    CALL CALC_FLAG_COM_[[TRAIN:指挿入れ]]
