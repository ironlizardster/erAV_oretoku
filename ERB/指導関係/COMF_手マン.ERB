;-------------------------------------------------
;手マン実行判定
;-------------------------------------------------
@COMABLE_[[TRAIN:手マン]]
#FUNCTION
    ;手マン実行判定
    RESULT = COMABLE_DEF(TNUM("手マン")) && COND("指の使用", PLAYER)
    RETURNF RESULT


;-------------------------------------------------
;調教時メッセージ
;-------------------------------------------------
@TRAIN_MESSAGE_COM_[[TRAIN:手マン]]
    IF TARGET == MASTER
        PRINTFORM %CALLNAME:TARGET%は
        SIF TALENT:PLAYER:恋心 && TEQUIP:獣姦プレイ == 0
            PRINT 愛しむような表情で、
        SIF TALENT:PLAYER:淫乱
            PRINT 自分から
        PRINTFORM %CALLNAME:TARGET%の秘所を
        IF CFLAG:PLAYER:特別コスタイプ == 83
            PRINTFORM レースパーティグローブをはめた
        ELSEIF CFLAG:PLAYER:特別コスタイプ == 85
            PRINTFORM エナメルロンググローブをはめた
        ENDIF
        PRINTFORML 指で刺激している…
    ELSE
        PRINTFORM %CALLNAME:PLAYER%は
        PRINTFORM %CALLNAME:TARGET%の
        SIF TALENT:淫乱
            PRINT 自から開いた
        PRINTFORM 秘所を
        IF CFLAG:PLAYER:特別コスタイプ == 83
            PRINTFORM レースパーティグローブをはめた
        ELSEIF CFLAG:PLAYER:特別コスタイプ == 85
            PRINTFORM エナメルロンググローブをはめた
        ENDIF
        PRINTFORML 指で刺激している…
    ENDIF

;-------------------------------------------------
;ソースの計算
;ARG:100％倍率
;-------------------------------------------------
@CALC_SOURCE_COM_[[TRAIN:手マン]](ARG=100)
    ;快Ｃのソース
    TMP_SRC:TARGET:快Ｃ += CALC_刺激SOURCE("Ｃ刺激", TARGET, 刺激_緩やか)
    ;快Ｖのソース
    TMP_SRC:TARGET:快Ｖ += CALC_刺激SOURCE("Ｖ刺激", TARGET, 刺激_緩やか)
	CALL APPLY_SOURCE_RATE(70)
    
    ;△COMF69との液体系ソース量の差が大きい（10倍）のでこっちを倍にしてみる
    ;こっち50:50で向こうを50:950とかでもいいんだけど、100:900のほうがなんとなく好みなので……
    TMP_SRC:TARGET:液体追加 = 100
    TMP_SRC:TARGET:愛液分泌 = 100
    TMP_SRC:TARGET:露出 = 220
    TMP_SRC:TARGET:逸脱 = 50
    
    ;調教者のTALENT:舌使いをみる
    IF TALENT:PLAYER:舌使い || TEQUIP:獣姦プレイ
        TIMES TMP_SRC:TARGET:快Ｃ , 2.00
        TMP_SRC:TARGET:恭順 += TMP_SRC:TARGET:快Ｃ/20
    ENDIF

    SIF IS_汚臭鈍感(TARGET)
        TMP_SRC:TARGET:不潔 += COM_汚れ(PLAYER,STNNUM("手"),STNNUM("ヴァギナ"),3,2) * 10 / 3
    SIF IS_汚臭敏感(TARGET)
        TMP_SRC:TARGET:不潔 += COM_汚れ(PLAYER,STNNUM("手"),STNNUM("ヴァギナ"),3,2) * 10 * 2

    ;調教者
    TMP_SRC:PLAYER:屈従 = 10
    SIF IS_FEMALE(TARGET) && IS_FEMALE(PLAYER) && !TALENT:PLAYER:両刀
        TMP_SRC:PLAYER:屈従 += 40

    TMP_SRC:PLAYER:逸脱 = 20
    SIF IS_汚臭鈍感(PLAYER)
        TMP_SRC:PLAYER:不潔 += COM_汚れ(TARGET,STNNUM("ヴァギナ"),STNNUM("手"),1,3) * 5 / 3
    SIF IS_汚臭敏感(PLAYER)
        TMP_SRC:PLAYER:不潔 += COM_汚れ(TARGET,STNNUM("ヴァギナ"),STNNUM("手"),1,3) * 5 * 2

    TMP_SRC:PLAYER:性行動 = 200 + MIN(ABL:PLAYER:奉仕精神, 5) * 30
    TEMP_NUM = 50 + MIN(ABL:PLAYER:奉仕精神, 5) * 50 + LIMIT(ABL:PLAYER:奉仕精神 - 1,0,4) * 50 + LIMIT(ABL:PLAYER:奉仕精神 - 3,0,2) * 50 + LIMIT(ABL:PLAYER:奉仕精神 - 4,0,1) * 50
    IF TEQUIP:PLAYER:奉仕
        TMP_SRC:PLAYER:屈従 += TEMP_NUM
        TMP_SRC:PLAYER:達成 += TEMP_NUM / 10
        TMP_SRC:TARGET:達成 += 10 + MIN(ABL:サドっ気, 5) * 10 + LIMIT(ABL:PLAYER:サドっ気 - 1,0,4) * 10 + LIMIT(ABL:PLAYER:サドっ気 - 3,0,2) * 20 + LIMIT(ABL:PLAYER:サドっ気 - 4,0,1) * 30
    ELSE
        TMP_SRC:PLAYER:達成 += TEMP_NUM
    ENDIF

    ;調教者がふたなりなら屈従半減
    SIF IS_FUTA(PLAYER)
        TMP_SRC:PLAYER:屈従 /= 2

	CALL APPLY_SOURCE_RATE(ARG)

;-------------------------------------------------
;経験上昇
;ARG:100％倍率
;-------------------------------------------------
@CALC_NOWEX_COM_[[TRAIN:手マン]](ARG=100)
    NOWEX:体力変動 += 5
    NOWEX:気力変動 += 5

    NOWEX:Ｂ開発経験 = 2
        
    ;レズ経験・ホモ経験
    IF HAVE_VAGINA(TARGET) && HAVE_VAGINA(PLAYER) 
        NOWEX:レズ経験 = 3
        NOWEX:PLAYER:レズ経験 = 3
    ENDIF

    IF CFLAG:好感度 >= 1000 && PLAYER == MASTER
        NOWEX:愛情経験 += 1
    ELSEIF CFLAG:PLAYER:好感度 >= 1000 && TARGET == MASTER
        NOWEX:PLAYER:愛情経験 += 1
    ENDIF
    
	CALL APPLY_EX_RATE(ARG)

;-------------------------------------------------
;FLAGの計算
;-------------------------------------------------
@CALC_FLAG_COM_[[TRAIN:手マン]]
    TCVAR:快楽経験 = 1
    TCVAR:PLAYER:奉仕経験 = 1
    ;-------------------------------------------------
    ;汚れの処理
    ;-------------------------------------------------
    ;奴隷のＶ⇔調教者の手の汚れが移動
    STAIN:ヴァギナ |= STAIN:PLAYER:手
    STAIN:PLAYER:手 |= STAIN:ヴァギナ

