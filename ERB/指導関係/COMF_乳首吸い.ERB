;-------------------------------------------------
;乳首吸い実行判定
;-------------------------------------------------
@COMABLE_[[TRAIN:乳首吸い]]
#FUNCTION
    ;乳首吸い実行判定
    RESULT = COMABLE_DEF([[TRAIN:乳首吸い]]) && COND("口の使用", PLAYER)
    RETURNF RESULT


;-------------------------------------------------
;調教時メッセージ
;-------------------------------------------------
@TRAIN_MESSAGE_COM_[[TRAIN:乳首吸い]]
    PRINTFORM %CALLNAME:PLAYER%は
    SIF CFLAG:ピアス状況 & 1
        PRINTL 、乳首を貫く金属製のピアスを舌で舐りながら、
    PRINTFORM %CALLNAME:TARGET%の
    IF IS_絶壁(TARGET)
        PRINT 真っ平らな
    ELSEIF IS_小柄(TARGET) && IS_貧乳(TARGET)
        PRINT 僅かに膨らみが感じられる程度の
    ELSEIF IS_貧乳(TARGET)
        PRINT 標準よりやや小さめの
    ELSEIF IS_巨乳(TARGET)
        PRINT 手から溢れそうなほどの
    ELSEIF IS_デカパイ(TARGET)
        PRINT 片乳だけで一抱えもある
    ENDIF

    IF TALENT:母乳体質 && PALAM:欲情 > PALAMLV:3 && TEQUIP:搾乳機 == 0 && TEQUIP:ニプルキャップ == 0
        PRINTL 乳房の先端の、
        PRINTL すっかり硬くなった突起を口で吸い上げた
        PRINTL 口から溢れんばかりの大量の母乳が流れ込んできた…
        SIF (TALENT:恋心 || TALENT:永遠の愛) && TEQUIP:縄 == 0 && PLAYER == MASTER && PALAM:恭順 > PALAMLV:4 && TFLAG:失神中終了 == 0
            PRINTFORML そんな%CALLNAME:PLAYER%の頭を、%CALLNAME:TARGET%は愛しげにぎゅっと抱きしめた
    ELSEIF TALENT:母乳体質 && TEQUIP:搾乳機 == 0 
        PRINTL 乳房にむしゃぶりついた
        PRINTFORML 口にふくんだ%CALLNAME:TARGET%の乳首から、甘ったるいミルクが噴き出してくる…
    ELSEIF PALAM:欲情 > PALAMLV:3 && TEQUIP:搾乳機 == 0 && TEQUIP:ニプルキャップ == 0
        PRINTL 胸の先端の、すっかり硬くなった突起を吸いあげた…
    ELSE
        PRINTL 乳房の先端を口で吸い上げた…
    ENDIF

;-------------------------------------------------
;ソースの計算
;ARG:100％倍率
;-------------------------------------------------
@CALC_SOURCE_COM_[[TRAIN:乳首吸い]](ARG=100)
    ;快Ｂのソース
    TMP_SRC:TARGET:快Ｂ += CALC_刺激SOURCE("Ｂ刺激", TARGET, 刺激_緩やか)
    ;情愛のソース
    TMP_SRC:TARGET:情愛 += 25 * MIN(ABL:Ｂ感覚 + 1, 4)
    TMP_SRC:TARGET:性行動 = 60
    SIF IS_汚臭鈍感(TARGET)
        TMP_SRC:TARGET:不潔 += COM_汚れ(PLAYER,STNNUM("口"),STNNUM("胸"),1,3) * 5 / 3
    SIF IS_汚臭敏感(TARGET)
        TMP_SRC:TARGET:不潔 += COM_汚れ(PLAYER,STNNUM("口"),STNNUM("胸"),1,3) * 5 * 2
    TMP_SRC:TARGET:露出 = 100

    ;調教者が［幼児退行］
    IF TALENT:PLAYER:幼児退行
        TIMES TMP_SRC:TARGET:快Ｂ , 1.20
        TIMES TMP_SRC:TARGET:情愛 , 1.20
    ENDIF

    ;調教者が［幼稚］
    IF TALENT:PLAYER:幼稚
        TIMES TMP_SRC:TARGET:快Ｂ , 1.20
        TIMES TMP_SRC:TARGET:情愛 , 1.20
    ENDIF

    ;-------------------------------------------------
    ;汚れの処理
    ;-------------------------------------------------
    ; ;奴隷の胸の汚れがなければ口をつかう（愛液と母乳よごれはＯＫ、汚れ無視か助手調教時は問題なし）
    ; IF !(CHECK_BITS_NOT_IN_MASK(STAIN:胸,STAIN_Ｖ,STAIN_乳)) || TALENT:(ARG:2):汚れ無視 == 1
    ;調教者のTALENT:舌使いをみる
    IF TALENT:PLAYER:舌使い
        TIMES TMP_SRC:TARGET:快Ｂ , 1.40
        TMP_SRC:TARGET:恭順 += TMP_SRC:TARGET:快Ｂ/20
    ENDIF

    ;調教者
    TMP_SRC:PLAYER:屈従 = 10
    SIF IS_MALE(TARGET) && IS_MALE(PLAYER) && !TALENT:PLAYER:両刀
        TMP_SRC:PLAYER:屈従 += 40

    TMP_SRC:PLAYER:逸脱 = 20
    SIF IS_汚臭鈍感(PLAYER)
        TMP_SRC:PLAYER:不潔 += COM_汚れ(TARGET,STNNUM("胸"),STNNUM("口"),1,1) * 10 / 3
    SIF IS_汚臭敏感(PLAYER)
        TMP_SRC:PLAYER:不潔 += COM_汚れ(TARGET,STNNUM("胸"),STNNUM("口"),1,1) * 10 * 2

    TMP_SRC:PLAYER:性行動 = 150 + MIN(ABL:PLAYER:奉仕精神, 5) * 30
    TEMP_NUM= 30 + MIN(ABL:PLAYER:奉仕精神, 5) * 30 + LIMIT(ABL:PLAYER:奉仕精神 - 1,0,4) * 40 + LIMIT(ABL:PLAYER:奉仕精神 - 3,0,2) * 50 + LIMIT(ABL:PLAYER:奉仕精神 - 4,0,1) * 50
    IF TEQUIP:PLAYER:奉仕
        TMP_SRC:PLAYER:屈従 += TEMP_NUM
        TMP_SRC:PLAYER:達成 += TEMP_NUM / 10
        TMP_SRC:TARGET:達成 += 10 + MIN(ABL:サドっ気, 5) * 10 + LIMIT(ABL:PLAYER:サドっ気 - 1,0,4) * 10 + LIMIT(ABL:PLAYER:サドっ気 - 3,0,2) * 20 + LIMIT(ABL:PLAYER:サドっ気 - 4,0,1) * 30
    ELSE
        TMP_SRC:PLAYER:達成 += TEMP_NUM
    ENDIF
 
    CALL EVENT_JUNYU
    
	CALL APPLY_SOURCE_RATE(ARG)


;-------------------------------------------------
;経験上昇
;ARG:100％倍率
;-------------------------------------------------
@CALC_NOWEX_COM_[[TRAIN:乳首吸い]](ARG=100)
    NOWEX:体力変動 += 5
    NOWEX:気力変動 += 5

    NOWEX:Ｂ開発経験 = 3
        
    ;レズ経験・ホモ経験
    IF HAVE_VAGINA(TARGET) && HAVE_VAGINA(PLAYER) 
        NOWEX:レズ経験 = 5
        NOWEX:PLAYER:レズ経験 = 5
    ELSEIF IS_MALE(TARGET) && IS_MALE(PLAYER) 
        NOWEX:ＢＬ経験 = 5
        NOWEX:PLAYER:ＢＬ経験 = 5
    ENDIF

    IF CFLAG:好感度 >= 1000 && PLAYER == MASTER
        NOWEX:愛情経験 += 2
    ELSEIF CFLAG:PLAYER:好感度 >= 1000 && TARGET == MASTER
        NOWEX:PLAYER:愛情経験 += 2
    ENDIF
    
	CALL APPLY_EX_RATE(ARG)

;-------------------------------------------------
;FLAGの計算
;-------------------------------------------------
@CALC_FLAG_COM_[[TRAIN:乳首吸い]]
    TCVAR:快楽経験 = 1
    TCVAR:PLAYER:奉仕経験 = 1
    STAIN:胸 |= STAIN:PLAYER:口
    STAIN:PLAYER:口 |= STAIN:胸

