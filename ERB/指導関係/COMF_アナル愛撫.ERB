        SIF PALAM:欲情 >= PALAMLV:3 && ABL:Ａ感覚 >= 3
            PRINT て、指先で直腸までかきまわし
        PRINTL た…
    ENDIF

;-------------------------------------------------
;ソースの計算
;ARG:100％倍率
;-------------------------------------------------
@CALC_SOURCE_COM_[[TRAIN:アナル愛撫]](ARG=100)
    ;快Ａのソース
    TMP_SRC:TARGET:快Ａ += CALC_刺激SOURCE("Ａ刺激", TARGET, 刺激_緩やか)

    TMP_SRC:TARGET:露出 = 850
    TMP_SRC:TARGET:逸脱 = 200

    SIF !TEQUIP:PLAYER:奉仕
        TMP_SRC:TARGET:屈従 += 300 + MIN(ABL:Ａ感覚, 5) * 50 + LIMIT(ABL:Ａ感覚 - 2,0,4) * 200 + LIMIT(ABL:Ａ感覚 - 3,0,2) * 100 + LIMIT(ABL:Ａ感覚 - 4,0,1) * 150

    ;EXP:Ａ経験をみる
    SELECTCASE GETEXPLV(EXP:Ａ経験, 5)
        CASE 0
            TIMES TMP_SRC:TARGET:快Ａ , 0.20
            TIMES TMP_SRC:TARGET:屈従, 0.20
            TMP_SRC:TARGET:痛覚 = 500
            TMP_SRC:TARGET:逸脱 += 200
        CASE 1
            TIMES TMP_SRC:TARGET:快Ａ , 0.50
            TIMES TMP_SRC:TARGET:屈従, 0.50
            TMP_SRC:TARGET:痛覚 = 400
            TMP_SRC:TARGET:逸脱 += 100
        CASE 2
            TIMES TMP_SRC:TARGET:快Ａ , 1.00
            TIMES TMP_SRC:TARGET:屈従, 1.00
            TMP_SRC:TARGET:痛覚 = 300
            TMP_SRC:TARGET:逸脱 += 50
        CASE 3
            TIMES TMP_SRC:TARGET:快Ａ , 1.20
            TIMES TMP_SRC:TARGET:屈従, 1.20
            TMP_SRC:TARGET:痛覚 = 200
        CASE 4
            TIMES TMP_SRC:TARGET:快Ａ , 1.60
            TIMES TMP_SRC:TARGET:屈従, 1.60
            TMP_SRC:TARGET:痛覚 = 100
        CASEELSE
            TIMES TMP_SRC:TARGET:快Ａ , 1.80
            TIMES TMP_SRC:TARGET:屈従, 1.80
            TMP_SRC:TARGET:痛覚 = 50
    ENDSELECT

    ;PALAM:潤滑をみる
    SELECTCASE GETPALAMLV(PALAM:潤滑 , 4)
        CASE 0
            TIMES TMP_SRC:TARGET:快Ａ , 0.10
            TIMES TMP_SRC:TARGET:屈従, 0.10
            TIMES TMP_SRC:TARGET:痛覚 , 3.00
        CASE 1
            TIMES TMP_SRC:TARGET:快Ａ , 0.20
            TIMES TMP_SRC:TARGET:屈従, 0.20
            TIMES TMP_SRC:TARGET:痛覚 , 2.00
        CASE 2
            TIMES TMP_SRC:TARGET:快Ａ , 0.60
            TIMES TMP_SRC:TARGET:屈従, 0.60
            TIMES TMP_SRC:TARGET:痛覚 , 1.00
        CASE 3
            TIMES TMP_SRC:TARGET:快Ａ , 1.00
            TIMES TMP_SRC:TARGET:屈従, 1.00
            TIMES TMP_SRC:TARGET:痛覚 , 0.50
        CASEELSE
            TIMES TMP_SRC:TARGET:快Ａ , 2.00
            TIMES TMP_SRC:TARGET:屈従, 2.00
            TIMES TMP_SRC:TARGET:痛覚 , 0.10
    ENDSELECT

    ;PALAM:欲情をみる
    SELECTCASE GETPALAMLV(PALAM:欲情 , 4)
        CASE 0
            TIMES TMP_SRC:TARGET:快Ａ , 0.30
            TIMES TMP_SRC:TARGET:屈従, 0.30
        CASE 1
            TIMES TMP_SRC:TARGET:快Ａ , 0.60
            TIMES TMP_SRC:TARGET:屈従, 0.60
        CASE 2
            TIMES TMP_SRC:TARGET:快Ａ , 1.00
            TIMES TMP_SRC:TARGET:屈従, 1.00
        CASE 3
            TIMES TMP_SRC:TARGET:快Ａ , 1.30
            TIMES TMP_SRC:TARGET:屈従, 1.30
        CASEELSE
            TIMES TMP_SRC:TARGET:快Ａ , 1.60
            TIMES TMP_SRC:TARGET:屈従, 1.60
    ENDSELECT

    ;Ａ敏感、鈍感をみる
    ;快Ａ自体のチェックは後でまとめてやる
    IF IS_Ａ鈍感(TARGET)
        TIMES TMP_SRC:TARGET:痛覚 , 0.60
        TIMES TMP_SRC:TARGET:屈従 , 0.60
        TIMES TMP_SRC:TARGET:逸脱 , 0.60
    ELSEIF IS_Ａ敏感(TARGET)
        TIMES TMP_SRC:TARGET:痛覚 , 1.50
        TIMES TMP_SRC:TARGET:屈従 , 1.50
        TIMES TMP_SRC:TARGET:逸脱 , 1.50
    ENDIF

    ;処女で貞操観念
    IF IS処女(TARGET) && IS_貞操観念(TARGET)
        TIMES TMP_SRC:TARGET:屈従 , 0.80
        TIMES TMP_SRC:TARGET:逸脱 , 0.50
    ENDIF

    ;未熟
    SIF TALENT:未熟
        TIMES TMP_SRC:TARGET:痛覚 , 2.00

    ;調教者
    TMP_SRC:PLAYER:屈従 = 100
    SIF ((IS_FEMALE(TARGET) && IS_FEMALE(PLAYER)) || (IS_MALE(TARGET) && IS_MALE(PLAYER))) && !TALENT:PLAYER:両刀
        TMP_SRC:PLAYER:屈従 += 400

    TMP_SRC:PLAYER:逸脱 = 200
    SIF IS_汚臭鈍感(PLAYER)
        TMP_SRC:PLAYER:不潔 += COM_汚れ(TARGET,STNNUM("アナル"),STNNUM("手"),1,3) * 5 / 3
    SIF IS_汚臭敏感(PLAYER)
        TMP_SRC:PLAYER:不潔 += COM_汚れ(TARGET,STNNUM("アナル"),STNNUM("手"),1,3) * 5 * 2

    TMP_SRC:PLAYER:性行動 = 250 + MIN(ABL:PLAYER:奉仕精神, 5) * 50
    TEMP_NUM = 50 + MIN(ABL:PLAYER:奉仕精神, 5) * 50 + LIMIT(ABL:PLAYER:奉仕精神 - 1,0,4) * 50 + LIMIT(ABL:PLAYER:奉仕精神 - 3,0,2) * 100 + LIMIT(ABL:PLAYER:奉仕精神 - 4,0,1) * 100
    IF TEQUIP:PLAYER:奉仕
        TMP_SRC:PLAYER:屈従 += TEMP_NUM
        TMP_SRC:PLAYER:達成 += TEMP_NUM / 10
        TMP_SRC:TARGET:達成 += 10 + MIN(ABL:サドっ気, 5) * 10 + LIMIT(ABL:PLAYER:サドっ気 - 1,0,4) * 10 + LIMIT(ABL:PLAYER:サドっ気 - 3,0,2) * 20 + LIMIT(ABL:PLAYER:サドっ気 - 4,0,1) * 30
    ELSE
        TMP_SRC:PLAYER:達成 += TEMP_NUM
    ENDIF

	CALL APPLY_SOURCE_RATE(ARG)


;-------------------------------------------------
;経験上昇
;ARG:100％倍率
;-------------------------------------------------
@CALC_NOWEX_COM_[[TRAIN:アナル愛撫]](ARG=100)
    NOWEX:体力変動 += 20
    NOWEX:気力変動 += 50

    NOWEX:Ａ経験 = 1 + ABL:Ａ感覚 > 1 + ABL:Ａ感覚 > 4 + ABL:Ａ感覚 > 7
        
    ;レズ経験・ホモ経験
    IF HAVE_VAGINA(TARGET) && HAVE_VAGINA(PLAYER) 
        NOWEX:レズ経験 = 2
        NOWEX:PLAYER:レズ経験 = 2
    ELSEIF IS_MALE(TARGET) && IS_MALE(PLAYER) 
        NOWEX:ＢＬ経験 = 5
        NOWEX:PLAYER:ＢＬ経験 = 5
    ENDIF

    IF CFLAG:好感度 >= 1000 && PLAYER == MASTER
        NOWEX:愛情経験 += 2
    ELSEIF CFLAG:PLAYER:好感度 >= 1000 && TARGET == MASTER
        NOWEX:PLAYER:愛情経験 += 2
    ENDIF

	CALL APPLY_EX_RATE(ARG)

;-------------------------------------------------
;FLAGの計算
;-------------------------------------------------
@CALC_FLAG_COM_[[TRAIN:アナル愛撫]]
    TCVAR:快楽経験 |= ABL:Ａ感覚 > 1
    TCVAR:PLAYER:奉仕経験 = 1
    ;-------------------------------------------------
    ;汚れの処理
    ;-------------------------------------------------
    IF TEQUIP:触手召喚
        ;奴隷のＡに触手の汚れがつく
        STAIN:アナル |= 2
        STAIN:アナル |= 4
    ELSE
        ;奴隷のＡ⇔調教者の指の汚れが移動
        STAIN:アナル |= STAIN:PLAYER:手
        STAIN:PLAYER:手 |= STAIN:アナル
    ENDIF

