;-------------------------------------------------
;パイズリ実行判定
;-------------------------------------------------
@COMABLE_[[TRAIN:パイズリ]]
#FUNCTION
    ;パイズリ実行判定
    RESULT = COMABLE_DEF(TNUM("パイズリ")) && COND("乳首の使用", PLAYER)
    RETURNF RESULT


;-------------------------------------------------
;調教時メッセージ
;-------------------------------------------------
@TRAIN_MESSAGE_COM_[[TRAIN:パイズリ]]
    PRINTFORM %CALLNAME:PLAYER%は
    IF (CFLAG:PLAYER:着衣状態 & 64) && CFLAG:PLAYER:特別コスタイプ <= 50
        CALL PRINT_CLOTHTYPE_SPECIAL
        PRINT ごしに、
    ELSEIF CFLAG:PLAYER:着衣状態 & 28
        CALL PRINT_上着タイプ(PLAYER)
        PRINT ごしに、
    ELSEIF (CFLAG:PLAYER:着衣状態 & 2)
        PRINT 下着ごしに、
    ENDIF
    
    SIF TALENT:PLAYER:恋心 && TARGET == MASTER
        PRINT うっとりとした表情をしながら、
    IF IS_貧乳(PLAYER)
        PRINTFORM 薄い胸で懸命に
            ;獣姦プレイ中
            IF TEQUIP:PLAYER:獣姦プレイ
                PRINTFORM 犬のペニスを
            ELSE
                PRINTFORM %CALLNAME:TARGET%のペニスを
            ENDIF
    ELSEIF IS_巨乳(PLAYER)
        PRINTFORM 豊満な胸で
            ;獣姦プレイ中
            IF TEQUIP:PLAYER:獣姦プレイ
                    PRINTFORM 犬のペニスを包み込んで
                ELSE
                    PRINTFORM %CALLNAME:TARGET%のペニスを包み込んで
                ENDIF
    ELSEIF IS_デカパイ(PLAYER)
        PRINTFORM 両の乳房の間にすっかりうずまった
            ;獣姦プレイ中
            IF TEQUIP:PLAYER:獣姦プレイ
                    PRINTFORM 犬のペニスを
                ELSE
                    PRINTFORM %CALLNAME:TARGET%のペニスを
                ENDIF
    ELSE
        PRINTFORM 胸で
            ;獣姦プレイ中
            IF TEQUIP:PLAYER:獣姦プレイ
                    PRINTFORM 犬のペニスをはさんで
                ELSE
                    PRINTFORM %CALLNAME:TARGET%のペニスをはさんで
                ENDIF
    ENDIF
    PRINTL 擦りあげている…


;-------------------------------------------------
;ソースの計算
;ARG:100％倍率
;-------------------------------------------------
@CALC_SOURCE_COM_[[TRAIN:パイズリ]](ARG=100)
    ;-------------------------------------------------
    ;パイズリをされた対象
    ;-------------------------------------------------
    ;快Ｃのソース
    ;ABL:技巧をみる
    TMP_SRC:TARGET:快Ｃ += 1500 + MIN(ABL:PLAYER:技巧, 5) * 600 + LIMIT(ABL:PLAYER:技巧 - 1,0,4) * 200 + LIMIT(ABL:PLAYER:技巧 - 2,0,3) * 300
    TMP_SRC:TARGET:露出 = 220
    TMP_SRC:TARGET:逸脱 = 50

    IF PLAYER == MASTER || TARGET == MASTER
        TEMP_NUM = TARGET
        SIF TARGET == MASTER
            TEMP_NUM = PLAYER
        ;ABL:従順をみる
        TMP_SRC:TARGET:快Ｃ = TMP_SRC:TARGET:快Ｃ * (MIN(ABL:TEMP_NUM:信頼, 5)*10 + 80) / 100

        ;ABL:精液中毒をみる
        TMP_SRC:TARGET:快Ｃ = TMP_SRC:TARGET:快Ｃ * (MIN(ABL:PLAYER:精液中毒, 5)*10 + 80) / 100
        TMP_SRC:TARGET:快Ｃ = TMP_SRC:TARGET:快Ｃ * (MIN(ABL:TARGET:射精中毒, 5)*10 + 80) / 100
    ELSE
        ;TARGETからPLAYERへの相性を見る
        SELECTCASE RELATION:(NO:PLAYER)
            CASE IS < 50
                TIMES TMP_SRC:TARGET:快Ｃ , 0.5
            CASE IS < 90
                TIMES TMP_SRC:TARGET:快Ｃ , 0.75
            CASE IS < 110
                TIMES TMP_SRC:TARGET:快Ｃ , 1
            CASE IS < 150
                TIMES TMP_SRC:TARGET:快Ｃ , 1.25
            CASE IS < 200
                TIMES TMP_SRC:TARGET:快Ｃ , 1.5
            CASE IS < 300
                TIMES TMP_SRC:TARGET:快Ｃ , 1.75
            CASEELSE
                TIMES TMP_SRC:TARGET:快Ｃ , 2
        ENDSELECT
    ENDIF
    SIF IS_汚臭鈍感(TARGET)
        TMP_SRC:TARGET:不潔 += COM_汚れ(PLAYER,STNNUM("胸"),STNNUM("ペニス"),1,3) * 5 / 3
    SIF IS_汚臭敏感(TARGET)
        TMP_SRC:TARGET:不潔 += COM_汚れ(PLAYER,STNNUM("胸"),STNNUM("ペニス"),1,3) * 5 * 2

    ;調教者
    ;快Ｂのソース
    TMP_SRC:PLAYER:快Ｂ += 100 * POWER(ABL:PLAYER:Ｂ感覚 + 1, 2)
    SIF IS_チチユレ(PLAYER) || IS_絶壁(PLAYER)
        TIMES TMP_SRC:PLAYER:快Ｂ, 1.20
    SIF IS_Ｂ敏感(PLAYER)
        TIMES TMP_SRC:PLAYER:快Ｂ, 1.20
    SIF IS_Ｂ鈍感(PLAYER)
        TIMES TMP_SRC:PLAYER:快Ｂ, 0.7
    SIF IS_汚臭鈍感(PLAYER)
        TMP_SRC:PLAYER:不潔 += COM_汚れ(TARGET,STNNUM("ペニス"),STNNUM("胸"),1,2) * 5 / 3
    SIF IS_汚臭敏感(PLAYER)
        TMP_SRC:PLAYER:不潔 += COM_汚れ(TARGET,STNNUM("ペニス"),STNNUM("胸"),1,2) * 5 * 2
    TMP_SRC:PLAYER:露出 += 250
    TMP_SRC:PLAYER:屈従 += 1800
    TMP_SRC:PLAYER:逸脱 += 900
    ;ABL:Ｂ感覚をみる
    TMP_SRC:PLAYER:性行動 += 420 + LIMIT(ABL:PLAYER:奉仕精神,0,5)*80
    TMP_SRC:PLAYER:達成 += LIMIT(ABL:PLAYER:奉仕精神+1,1,6)*150 + LIMIT(ABL:PLAYER:Ｂ感覚-1,0,4)*150 + LIMIT(ABL:PLAYER:Ｂ感覚-3,0,2)*300 + LIMIT(ABL:PLAYER:Ｂ感覚-4,0,1)*100

    ;ABL:技巧をみる
    SELECTCASE ABL:PLAYER:技巧
        CASE 0
            TIMES TMP_SRC:PLAYER:性行動 , 0.5
            TIMES TMP_SRC:PLAYER:達成 , 0.5
        CASE 1
            TIMES TMP_SRC:PLAYER:性行動 , 0.8
            TIMES TMP_SRC:PLAYER:達成 , 0.8
        CASE 2
            TIMES TMP_SRC:PLAYER:性行動 , 1
            TIMES TMP_SRC:PLAYER:達成 , 1
        CASE 3
            TIMES TMP_SRC:PLAYER:性行動 , 1.2
            TIMES TMP_SRC:PLAYER:達成 , 1.2
        CASE 4
            TIMES TMP_SRC:PLAYER:性行動 , 1.5
            TIMES TMP_SRC:PLAYER:達成 , 1.5
        CASEELSE
            TIMES TMP_SRC:PLAYER:性行動 , 2
            TIMES TMP_SRC:PLAYER:達成 , 2
    ENDSELECT
    
	CALL APPLY_SOURCE_RATE(ARG)


;-------------------------------------------------
;経験上昇
;ARG:100％倍率
;-------------------------------------------------
@CALC_NOWEX_COM_[[TRAIN:パイズリ]](ARG=100)
    NOWEX:体力変動 += 10
    NOWEX:気力変動 += 10
    NOWEX:PLAYER:体力変動 += 10
    NOWEX:PLAYER:気力変動 += 70
    SIF TALENT:PLAYER:精愛味覚
        NOWEX:PLAYER:気力変動 += 80

    NOWEX:PLAYER:Ｂ開発経験 = 3
        
    ;レズ経験・ホモ経験
    IF HAVE_VAGINA(TARGET) && HAVE_VAGINA(PLAYER) 
        NOWEX:レズ経験 = 7
        NOWEX:PLAYER:レズ経験 = 7
    ELSEIF IS_MALE(TARGET) && IS_MALE(PLAYER) 
        NOWEX:ＢＬ経験 = 7
        NOWEX:PLAYER:ＢＬ経験 = 7
    ENDIF

    IF CFLAG:好感度 >= 1000 && PLAYER == MASTER
        NOWEX:愛情経験 += 1
    ELSEIF CFLAG:PLAYER:好感度 >= 1000 && TARGET == MASTER
        NOWEX:PLAYER:愛情経験 += 1
    ENDIF
    
	CALL APPLY_EX_RATE(ARG)

;-------------------------------------------------
;FLAGの計算
;-------------------------------------------------
@CALC_FLAG_COM_[[TRAIN:パイズリ]]
    SIF PLAYER == MASTER
        TCVAR:主人経験 += 1
    IF TARGET == MASTER
        TCVAR:PLAYER:主人経験 += 1
        ;屈服刻印１に相当
        TCVAR:PLAYER:屈服刻印取得 = 2
    ENDIF
    TCVAR:快楽経験 = 1
    TCVAR:PLAYER:快楽経験 = 1
    TCVAR:PLAYER:奉仕経験 = 1
    STAIN:ペニス |= STAIN:PLAYER:胸
    STAIN:PLAYER:胸 |= STAIN:ペニス

