;-------------------------------------------------
;縦パイズリ実行判定
;-------------------------------------------------
@COMABLE_[[TRAIN:縦パイズリ]]
#FUNCTION
    ;縦パイズリ実行判定
    RESULT = COMABLE_DEF(TNUM("縦パイズリ")) && COND("乳首の使用", PLAYER)
    RETURNF RESULT


;-------------------------------------------------
;調教時メッセージ
;-------------------------------------------------
@TRAIN_MESSAGE_COM_[[TRAIN:縦パイズリ]]
    PRINTFORM %CALLNAME:PLAYER%は
    ;恋心
    SIF TALENT:PLAYER:恋心
        PRINT うっとりとした表情をしながら、
    ;巨乳
    IF IS_巨乳(PLAYER)
        PRINT 豊満な胸でペニスを包み込み、胸を振るようにして
    ;爆乳
    ELSEIF IS_デカパイ(PLAYER)
        PRINT 豊満すぎる程の胸でペニスを包み隠し、胸を揉み込むようにして
    ENDIF
    PRINTW 刺激している……

;-------------------------------------------------
;ソースの計算
;ARG:100％倍率
;-------------------------------------------------
@CALC_SOURCE_COM_[[TRAIN:縦パイズリ]](ARG=100)       
	CALL CALC_SOURCE_COM_[[TRAIN:パイズリ]](ARG)


;-------------------------------------------------
;経験上昇
;ARG:100％倍率
;-------------------------------------------------
@CALC_NOWEX_COM_[[TRAIN:縦パイズリ]](ARG=100)
	CALL CALC_NOWEX_COM_[[TRAIN:パイズリ]](ARG)

;-------------------------------------------------
;FLAGの計算
;-------------------------------------------------
@CALC_FLAG_COM_[[TRAIN:縦パイズリ]]
    SIF PLAYER == MASTER
        TCVAR:主人経験 += 1
    IF TARGET == MASTER
        TCVAR:PLAYER:主人経験 += 1
        ;屈服刻印１に相当
        TCVAR:PLAYER:屈服刻印取得 = 2
    ENDIF
    TCVAR:快楽経験 = 1
    TCVAR:PLAYER:快楽経験 = 1
    TCVAR:PLAYER:被虐快楽経験 = 1
    STAIN:ペニス |= STAIN:PLAYER:胸
    STAIN:PLAYER:胸 |= STAIN:ペニス


