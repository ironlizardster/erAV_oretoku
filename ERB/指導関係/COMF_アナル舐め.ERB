;-------------------------------------------------
;アナル舐め実行判定
;-------------------------------------------------
@COMABLE_[[TRAIN:アナル舐め]]
#FUNCTION
    ;アナル舐め実行判定
    RESULT = COMABLE_DEF(TNUM("アナル舐め")) && COND("口の使用", PLAYER)
    RETURNF RESULT


;-------------------------------------------------
;調教時メッセージ
;-------------------------------------------------
@TRAIN_MESSAGE_COM_[[TRAIN:アナル舐め]]
    IF TEQUIP:獣姦プレイ
        PRINTFORM 犬は熱い息を吹きかけながら、
    ELSE
        PRINTFORM %CALLNAME:PLAYER%は
    ENDIF
    PRINTFORM %CALLNAME:TARGET%の
    SIF EXP:Ａ経験 <= 10
        PRINT 硬く閉ざされた
    PRINT アヌスを丁寧に舐めほぐし
    SIF EXP:Ａ経験 >= 50 && PALAM:欲情 >= PALAMLV:3
        PRINT 、舌先を突き入れて穴の中までかきまわしてやっ
    PRINTL た…


;-------------------------------------------------
;ソースの計算
;ARG:100％倍率
;-------------------------------------------------
@CALC_SOURCE_COM_[[TRAIN:アナル舐め]](ARG=100)
    ;快Ａのソース
    TMP_SRC:TARGET:快Ａ += CALC_刺激SOURCE("Ａ刺激", TARGET, 刺激_緩やか)

    TMP_SRC:TARGET:愛液分泌 = 50
    TMP_SRC:TARGET:露出 = 300
    TMP_SRC:TARGET:逸脱 = 500

    SIF !TEQUIP:PLAYER:奉仕
        TMP_SRC:TARGET:屈従 += 100 + MIN(ABL:Ａ感覚, 5) * 50 + LIMIT(ABL:Ａ感覚 - 2,0,4) * 75 + LIMIT(ABL:Ａ感覚 - 3,0,2) * 100 + LIMIT(ABL:Ａ感覚 - 4,0,1) * 150

    ;EXP:Ａ経験をみる
    SELECTCASE GETEXPLV(EXP:Ａ経験, 5)
        CASE 0
            TIMES TMP_SRC:TARGET:快Ａ , 0.20
            TIMES TMP_SRC:TARGET:屈従, 0.20
            TMP_SRC:TARGET:逸脱 += 200
        CASE 1
            TIMES TMP_SRC:TARGET:快Ａ , 0.50
            TIMES TMP_SRC:TARGET:屈従, 0.50
            TMP_SRC:TARGET:逸脱 += 100
        CASE 2
            TIMES TMP_SRC:TARGET:快Ａ , 1.00
            TIMES TMP_SRC:TARGET:屈従, 1.00
            TMP_SRC:TARGET:逸脱 += 50
        CASE 3
            TIMES TMP_SRC:TARGET:快Ａ , 1.20
            TIMES TMP_SRC:TARGET:屈従, 1.20
        CASE 4
            TIMES TMP_SRC:TARGET:快Ａ , 1.60
            TIMES TMP_SRC:TARGET:屈従, 1.60
        CASEELSE
            TIMES TMP_SRC:TARGET:快Ａ , 1.80
            TIMES TMP_SRC:TARGET:屈従, 1.80
    ENDSELECT

    ;PALAM:潤滑をみる
    SELECTCASE GETPALAMLV(PALAM:潤滑 , 4)
        CASE 0
            TIMES TMP_SRC:TARGET:快Ａ , 0.10
            TIMES TMP_SRC:TARGET:屈従, 0.10
        CASE 1
            TIMES TMP_SRC:TARGET:快Ａ , 0.20
            TIMES TMP_SRC:TARGET:屈従, 0.20
        CASE 2
            TIMES TMP_SRC:TARGET:快Ａ , 0.60
            TIMES TMP_SRC:TARGET:屈従, 0.60
        CASE 3
            TIMES TMP_SRC:TARGET:快Ａ , 1.00
            TIMES TMP_SRC:TARGET:屈従, 1.00
        CASEELSE
            TIMES TMP_SRC:TARGET:快Ａ , 2.00
            TIMES TMP_SRC:TARGET:屈従, 2.00
    ENDSELECT

    ;PALAM:欲情をみる
    SELECTCASE GETPALAMLV(PALAM:欲情 , 4)
        CASE 0
            TIMES TMP_SRC:TARGET:快Ａ , 0.30
            TIMES TMP_SRC:TARGET:屈従, 0.30
        CASE 1
            TIMES TMP_SRC:TARGET:快Ａ , 0.60
            TIMES TMP_SRC:TARGET:屈従, 0.60
        CASE 2
            TIMES TMP_SRC:TARGET:快Ａ , 1.00
            TIMES TMP_SRC:TARGET:屈従, 1.00
        CASE 3
            TIMES TMP_SRC:TARGET:快Ａ , 1.30
            TIMES TMP_SRC:TARGET:屈従, 1.30
        CASEELSE
            TIMES TMP_SRC:TARGET:快Ａ , 1.60
            TIMES TMP_SRC:TARGET:屈従, 1.60
    ENDSELECT

    ;Ａ敏感、鈍感をみる
    ;快Ａ自体のチェックは後でまとめてやる
    IF IS_Ａ鈍感(TARGET)
        TIMES TMP_SRC:TARGET:痛覚 , 0.60
        TIMES TMP_SRC:TARGET:屈従 , 0.60
    ELSEIF IS_Ａ敏感(TARGET)
        TIMES TMP_SRC:TARGET:痛覚 , 1.50
        TIMES TMP_SRC:TARGET:屈従 , 1.50
    ENDIF
    
    ;調教者のTALENT:舌使いをみる
    IF TALENT:PLAYER:舌使い || TEQUIP:獣姦プレイ
        TIMES TMP_SRC:TARGET:快Ａ , 2.00
        SIF !TEQUIP:獣姦プレイ
            TMP_SRC:TARGET:恭順 += TMP_SRC:TARGET:快Ｃ/20
    ENDIF

    ;調教者
    TMP_SRC:PLAYER:屈従 = 10
    SIF IS_FEMALE(TARGET) && IS_FEMALE(PLAYER) && !TALENT:PLAYER:両刀
        TMP_SRC:PLAYER:屈従 += 40

    TMP_SRC:PLAYER:逸脱 = 500
    SIF IS_汚臭鈍感(PLAYER)
        TMP_SRC:PLAYER:不潔 += COM_汚れ(TARGET,STNNUM("アナル"),STNNUM("口"),1,3) * 5 / 3
    SIF IS_汚臭敏感(PLAYER)
        TMP_SRC:PLAYER:不潔 += COM_汚れ(TARGET,STNNUM("アナル"),STNNUM("口"),1,3) * 5 * 2

    TMP_SRC:PLAYER:性行動 = 250 + MIN(ABL:PLAYER:奉仕精神, 5) * 50
    TEMP_NUM = 50 + MIN(ABL:PLAYER:奉仕精神, 5) * 50 + LIMIT(ABL:PLAYER:奉仕精神 - 1,0,4) * 50 + LIMIT(ABL:PLAYER:奉仕精神 - 3,0,2) * 100 + LIMIT(ABL:PLAYER:奉仕精神 - 4,0,1) * 100
    IF TEQUIP:PLAYER:奉仕
        TMP_SRC:PLAYER:屈従 += TEMP_NUM
        TMP_SRC:PLAYER:達成 += TEMP_NUM / 10
        TMP_SRC:TARGET:達成 += 10 + MIN(ABL:サドっ気, 5) * 10 + LIMIT(ABL:PLAYER:サドっ気 - 1,0,4) * 10 + LIMIT(ABL:PLAYER:サドっ気 - 3,0,2) * 20 + LIMIT(ABL:PLAYER:サドっ気 - 4,0,1) * 30
    ELSE
        TMP_SRC:PLAYER:達成 += TEMP_NUM
    ENDIF

	CALL APPLY_SOURCE_RATE(ARG)


;-------------------------------------------------
;経験上昇
;ARG:100％倍率
;-------------------------------------------------
@CALC_NOWEX_COM_[[TRAIN:アナル舐め]](ARG=100)
    NOWEX:体力変動 += 5
    NOWEX:気力変動 += 20

    NOWEX:Ａ経験 = 1
        
    ;レズ経験・ホモ経験
    IF HAVE_VAGINA(TARGET) && HAVE_VAGINA(PLAYER) 
        NOWEX:レズ経験 = 3
        NOWEX:PLAYER:レズ経験 = 3
    ELSEIF IS_MALE(TARGET) && IS_MALE(PLAYER) 
        NOWEX:ＢＬ経験 = 3
        NOWEX:PLAYER:ＢＬ経験 = 3
    ENDIF

    IF CFLAG:好感度 >= 1000 && PLAYER == MASTER
        NOWEX:愛情経験 += 2
    ELSEIF CFLAG:PLAYER:好感度 >= 1000 && TARGET == MASTER
        NOWEX:PLAYER:愛情経験 += 2
    ENDIF

	CALL APPLY_EX_RATE(ARG)

;-------------------------------------------------
;FLAGの計算
;-------------------------------------------------
@CALC_FLAG_COM_[[TRAIN:アナル舐め]]
    TCVAR:快楽経験 |= ABL:Ａ感覚 > 1
    TCVAR:PLAYER:奉仕経験 = 1
    ;-------------------------------------------------
    ;汚れの処理
    ;-------------------------------------------------
    ;奴隷のＡ⇔調教者の口の汚れが移動
    STAIN:アナル |= STAIN:PLAYER:口
    STAIN:PLAYER:口 |= STAIN:アナル


;-------------------------------------------------
;調教時メッセージ
;-------------------------------------------------
@TRAIN_MESSAGE_COM_[[TRAIN:胸愛撫]]アナル舐め
    PRINTFORM %CALLNAME:PLAYER%は%CALLNAME:TARGET%の
    SIF EXP:Ａ経験 <= 10
        PRINT 硬く閉ざされた
    PRINT アヌスを丁寧に舐めほぐし、
    SIF EXP:Ａ経験 >= 50 && PALAM:欲情 >= PALAMLV:3
        PRINT 舌先を突き入れて穴の中までかきまわしてやりながら
    PRINTFORM %CALLNAME:TARGET%の
    IF IS_絶壁(TARGET)
        PRINT 真っ平らな
    ELSEIF IS_小柄(TARGET) && IS_貧乳(TARGET)
        PRINT 僅かに膨らみが感じられる程度の
    ELSEIF IS_貧乳(TARGET)
        PRINT 標準よりやや小さめの
    ELSEIF IS_巨乳(TARGET)
        PRINT 手から溢れそうなほどの
    ELSEIF IS_デカパイ(TARGET)
        PRINT 片乳だけで一抱えもある
    ENDIF
                        ;****スライムパッチ追加ここから****
    IF TEQUIP:スライム生成
        PRINTFORML 胸に纏わり付いたスライムは%CALLNAME:TARGET%の胸に集まり始めた…
                        ;****スライムパッチ追加ここまで****
    ELSEIF TEQUIP:触手召喚
        PRINTL 胸を絞り上げるように、幾本もの触手が絡みついた…
    ELSEIF TEQUIP:獣姦プレイ
        PRINTL 胸をねぶりまわしている…
    ELSEIF PALAM:欲情 > PALAMLV:3 && TEQUIP:搾乳機 == 0 && TEQUIP:ニプルキャップ == 0
        PRINTL 胸の先端の、すっかり硬くなった突起をつまみあげた…
    ELSEIF IS_絶壁(TARGET)
        PRINTL 胸を撫で回した…
    ELSE
        PRINTL 胸を揉みしだいた…
    ENDIF

;-------------------------------------------------
;調教時メッセージ
;-------------------------------------------------
@TRAIN_MESSAGE_COM_[[TRAIN:手マン]]アナル舐め
    PRINTFORM %CALLNAME:PLAYER%は%CALLNAME:TARGET%の
    SIF EXP:Ａ経験 <= 10
        PRINT 硬く閉ざされた
    PRINT アヌスを丁寧に舐めほぐし、
    SIF EXP:Ａ経験 >= 50 && PALAM:欲情 >= PALAMLV:3
        PRINT 舌先を突き入れて穴の中までかきまわしてやりながら
    IF IS_FUTA(TARGET) && PALAM:欲情 >= PALAMLV:3
        PRINT そそり勃ったペニスに指を絡めて擦りあげている
    ELSEIF IS_FUTA(TARGET)
        PRINT ペニスを指で愛撫している
    ELSEIF PALAM:欲情 >= PALAMLV:3
        PRINT 尖りきったクリトリスを指で摘まみ上げた
    ELSE
        PRINT クリトリスを指でこねくり回した
    ENDIF
    PRINTL …

;-------------------------------------------------
;調教時メッセージ
;-------------------------------------------------
@TRAIN_MESSAGE_COM_[[TRAIN:指挿入れ]]アナル舐め
    PRINTFORM %CALLNAME:PLAYER%は%CALLNAME:TARGET%の
    SIF EXP:Ａ経験 <= 10
        PRINT 硬く閉ざされた
    PRINT アヌスを丁寧に舐めほぐし、
    SIF EXP:Ａ経験 >= 50 && PALAM:欲情 >= PALAMLV:3
        PRINT 舌先を突き入れて穴の中までかきまわしてやりながら
    IF EXP:Ｖ経験 == 0
        PRINT 男を知らない
    ELSEIF PALAM:潤滑 >= PALAMLV:4
        PRINT 濡れそぼった
    ENDIF
    IF TALENT:幼稚
        PRINT 幼いワレメ
    ELSE
        PRINT 秘裂
    ENDIF
    IF TEQUIP:バイブ
        PRINTFORML の中で、妖しくうねるバイブを前後に抜き差しした
    ELSE
        PRINTFORML に自分の指をゆっくりと挿入した…
    ENDIF
    ;Gスポット刺激
    IF TEQUIP:バイブ && PALAM:欲情 >= PALAMLV:3 && ABL:Ｖ感覚 >= 3
        PRINTFORML %CALLNAME:TARGET%の膣は、蜜に濡れたバイブにねっとりと絡み付いている…
    ELSEIF TEQUIP:バイブ && PALAM:欲情 <= PALAMLV:3 && ABL:Ｖ感覚 >= 3
        PRINTFORML %CALLNAME:TARGET%はバイブの刺激に悶えている…
    ELSEIF TEQUIP:バイブ && PALAM:欲情 >= PALAMLV:3 && ABL:Ｖ感覚 <= 2
        PRINTFORML %CALLNAME:TARGET%は頬を染めて時折声を上げている…
    ELSEIF TEQUIP:バイブ && PALAM:欲情 <= PALAMLV:3 && ABL:Ｖ感覚 <= 2
        PRINTFORML %CALLNAME:TARGET%は少し苦しそうな表情をしている…
    ELSEIF EXP:Ｖ経験 <= 1
        PRINTFORML %CALLNAME:TARGET%は膣内の異物感に怯えている…
    ELSEIF EXP:Ｖ経験 >= 1 && EXP:Ｖ経験 <= 30
        PRINTFORML %CALLNAME:TARGET%は指の感触に吐息を吐いて耐えている…
    ELSEIF EXP:Ｖ経験 >= 31 && EXP:Ｖ経験 <= 50
        PRINTFORML %CALLNAME:TARGET%は指の感触を楽しんでいるようだ…
    ELSEIF EXP:Ｖ経験 >= 51 && EXP:Ｖ経験 <= 80
        PRINTFORML %CALLNAME:TARGET%は指のうごめく感触にうっとりとしている…
    ELSEIF EXP:Ｖ経験 >= 81 && EXP:Ｖ経験 <= 120
        PRINTFORML %CALLNAME:TARGET%はお腹の中をかき回される感覚に熱い吐息を吐いて悶えている…
    ELSEIF EXP:Ｖ経験 >= 121
        PRINTFORML %CALLNAME:TARGET%は涎をたらし、自ら腰を振って快楽を貪っている…
    ENDIF

;-------------------------------------------------
;調教時メッセージ
