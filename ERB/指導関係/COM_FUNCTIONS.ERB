;-------------------------------------------------
;TARGETにおけるコマンドARGがPLAYERとしてはどのコマンドに相当するかを返す
;例)クンニの逆は奉仕クンニなのでPREVCOM(TNUM("クンニ") ) = TNUM("奉仕クンニ")
;-------------------------------------------------
@REVCOM(ARG)
#FUNCTION
    SELECTCASE ARG
        CASE TNUM("クンニ"), TNUM("奉仕クンニ")
            RETURNF TNUM("クンニ") + TNUM("奉仕クンニ") - ARG
        CASE TNUM("自慰"), TNUM("自慰する")
            RETURNF TNUM("自慰") + TNUM("自慰する") - ARG
        CASE TNUM("フェラする"), TNUM("フェラチオ")
            RETURNF TNUM("フェラする") + TNUM("フェラチオ") - ARG
        CASE TNUM("胸愛撫"), TNUM("胸愛撫させる")
            RETURNF TNUM("胸愛撫") + TNUM("胸愛撫させる") - ARG
        CASE TNUM("アナル舐め"), TNUM("アナル奉仕")
            RETURNF TNUM("アナル舐め") + TNUM("アナル奉仕") - ARG
        CASE TNUM("手コキする"), TNUM("手淫")
            RETURNF TNUM("手コキする") + TNUM("手淫") - ARG
        CASE TNUM("パイズリする"), TNUM("パイズリ")
            RETURNF TNUM("パイズリする") + TNUM("パイズリ") - ARG
        CASE TNUM("足コキする"), TNUM("足コキ")
            RETURNF TNUM("足コキする") + TNUM("足コキ") - ARG
        CASE TNUM("バイブ"), TNUM("逆バイブ")
            RETURNF TNUM("バイブ") + TNUM("逆バイブ") - ARG
        CASE TNUM("アナルバイブ"), TNUM("逆Ａバイブ")
            RETURNF TNUM("アナルバイブ") + TNUM("逆Ａバイブ") - ARG
        CASE TNUM("オナホール"), TNUM("オナホコキ")
            RETURNF TNUM("オナホール") + TNUM("オナホコキ") - ARG
        CASE TNUM("正常位"), TNUM("正常位奉仕")
            RETURNF TNUM("正常位") + TNUM("正常位奉仕") - ARG
        CASE TNUM("後背位"), TNUM("後背位奉仕")
            RETURNF TNUM("後背位") + TNUM("後背位奉仕") - ARG
        CASE TNUM("騎乗位"), TNUM("騎乗位で犯す")
            RETURNF TNUM("騎乗位") + TNUM("騎乗位で犯す") - ARG
        CASE TNUM("アナル正常位"), TNUM("Ａ正常位奉仕")
            RETURNF TNUM("アナル正常位") + TNUM("Ａ正常位奉仕") - ARG
        CASE TNUM("アナル後背位"), TNUM("Ａ後背位奉仕")
            RETURNF TNUM("アナル後背位") + TNUM("Ａ後背位奉仕") - ARG
        CASE TNUM("アナル騎乗位"), TNUM("Ａ騎乗位で犯す")
            RETURNF TNUM("アナル騎乗位") + TNUM("Ａ騎乗位で犯す") - ARG
    ENDSELECT
    RETURNF ARG


;-------------------------------------------------
;GETNUM(TRAINNAME, "フェラチオ")が長すぎるのでTNUM("フェラチオ")と書けるようにしただけの関数
;ARGSが空白だったりTRAINNAMEに該当するものが無い文字列の場合には-1が返る
;-------------------------------------------------
@TNUM(ARGS)
#FUNCTION
    RESULT = GETNUM(TRAINNAME, ARGS)
    RETURNF RESULT

;-------------------------------------------------
;GETNUM(STAIN, "口")が長すぎるのでSTNNUM("口")と書けるようにしただけの関数
;ARGSが空白だったりSTAINNAMEに該当するものが無い文字列の場合には-1が返る
;-------------------------------------------------
@STNNUM(ARGS)
#FUNCTION
    RESULT = GETNUM(STAIN, ARGS)
    RETURNF RESULT

;-------------------------------------------------
;前回のターゲットに調教命令を実行したプレイヤーが同じか確認
;ARG:ターゲットID
;ARG:1:プレイヤーID
;-------------------------------------------------
@LAST_PLAYER_SAME(ARG=0,ARG:1=0)
#FUNCTION
    VARSET LOCALS
    ;記録を分解する。LOCALS:XX = ID となる
    SPLIT CSTR:ARG:前回プレイヤー, "/", LOCALS

    FOR LOCAL, 0, 50
        SIF LOCALS:LOCAL == ""
            BREAK
        RESULT = TOINT(LOCALS:LOCAL) == ARG:1
        SIF RESULT
            RETURNF RESULT
    NEXT
    RETURNF RESULT

;-------------------------------------------------
;倍率の計算
;ARG:100％倍率
;-------------------------------------------------
@APPLY_EX_RATE(ARG)
	FOR LOCAL, 0, VARSIZE("EX")
        NOWEX:LOCAL = NOWEX:LOCAL * ARG / 100
        NOWEX:PLAYER:LOCAL = NOWEX:PLAYER:LOCAL * ARG / 100
	NEXT
    ; VARSET NOWEX:TARGET:0
    ; VARSET NOWEX:PLAYER:0

;-------------------------------------------------
;倍率の計算
;ARG:100％倍率
;-------------------------------------------------
@APPLY_SOURCE_RATE(ARG)
	FOR LOCAL, 0, VARSIZE("SOURCE")
        TMP_SRC:TARGET:LOCAL = TMP_SRC:TARGET:LOCAL * ARG / 100
        TMP_SRC:PLAYER:LOCAL = TMP_SRC:PLAYER:LOCAL * ARG / 100
	NEXT
    ; VARSET TMP_SRC:TARGET:0
    ; VARSET TMP_SRC:PLAYER:0

;-------------------------------------------------
;プレイヤーがキスを実行できるかどうか
;-------------------------------------------------
@WILL_PLAYER_KISS
#FUNCTION
    ;奴隷の口が愛液、精液、アナル、尿で汚れており、
    ;汚臭敏感で従順3以下のASSIの場合キスはしない（汚れ無視なら問題なし）
    RESULT = PLAYER == MASTER || !(CHECK_BITS_NOT_IN_MASK(STAIN:ARG:口,STAIN_Ｐ,STAIN_乳) && ABL:PLAYER:信頼 <= 3 && IS_汚臭敏感(PLAYER) && !TALENT:PLAYER:汚れ無視) 
    ;ボールギャグ使用中もキスはなし
    RESULT &= !TEQUIP:ボールギャグ
    ;初キス未体験だとキスを避ける
    RESULT &= CFLAG:初キス相手

    RETURNF RESULT

@CHECK_BITS_NOT_IN_MASK(ARG=0,ARG:1=0,ARG:2=0,ARG:3=0,ARG:4=0,ARG:5=0,ARG:6=0,ARG:7=0,ARG:8=0)
#FUNCTION
    FOR LOCAL, 1, 8
        LOCAL:1 = LOCAL:1 | ARG:LOCAL
    NEXT
    RESULT = ARG ^ LOCAL:1
    RETURNF RESULT

;-------------------------------------------------
;汚れの計算
;ARG:0:相手キャラID
;ARG:1:STAIN部位
;ARG:2:自キャラID
;ARG:3:自キャラ接触部位、現在は口に対する部分かそれ以外でどのSTAINを結果に加算するかを決める
;-------------------------------------------------
@COM_汚れ(ARG,ARG:1,ARG:2,ARG:3)
#FUNCTION
    RESULT = 0
    ;尿の汚れ
    SIF STAIN:ARG:(ARG:1) & STAIN_尿
        RESULT += 3
    SIF ARG:3 = STNNUM("口") && STAIN:ARG:(ARG:1) & STAIN_Ｖ
        RESULT += 1
    SIF ARG:3 = STNNUM("口") && STAIN:ARG:(ARG:1) & STAIN_Ｐ
        RESULT += 2
    ;精液の汚れ
    SIF STAIN:ARG:(ARG:1) & STAIN_精
        RESULT += 3
    ;アナルの汚れ
    SIF STAIN:ARG:(ARG:1) & STAIN_Ａ
        RESULT += 7
    SIF ARG:3 = STNNUM("口") && STAIN:ARG:(ARG:1) & STAIN_乳
        RESULT += 1
    ;尿の汚れ
    SIF STAIN:ARG:(ARG:1) & STAIN_尿
        RESULT += 3
    ;獣姦の場合は汚れ7
    SIF TEQUIP:ARG:獣姦プレイ
        RESULT += 7

    RESULT *= 5
    SIF IS_汚臭鈍感(ARG:2)
        RESULT /= 3
    SIF IS_汚臭敏感(ARG:2)
        RESULT *= 2

    SELECTCASE ARG:3
        CASE STNNUM("口")
            RESULT *= 4
        CASE STNNUM("手")
            RESULT /= 2
        CASE STNNUM("ペニス")
            RESULT *= 1
        CASE STNNUM("ヴァギナ")
            RESULT *= 2
        CASE STNNUM("アナル")
            RESULT /= 5
        CASE STNNUM("胸")
            RESULT *= 1
        CASE STNNUM("足")
            RESULT /= 2
        CASE STNNUM("顔")
            RESULT /= 3
        CASE STNNUM("髪")
            RESULT /= 2
        CASEELSE
    ENDSELECT
    RETURNF RESULT

@CHECK_BITS_NOT_IN_MASK(ARG=0,ARG:1=0,ARG:2=0,ARG:3=0,ARG:4=0,ARG:5=0,ARG:6=0,ARG:7=0,ARG:8=0)
#FUNCTION
    FOR LOCAL, 1, 8
        LOCAL:1 = LOCAL:1 | ARG:LOCAL
    NEXT
    RESULT = ARG ^ LOCAL:1
    RETURNF RESULT

-------------------------------------------------
;母乳体質への変化
;-------------------------------------------------
@EVENT_JUNYU
    ;【母乳体質】無しかつ【小柄】で無し【貧乳】無しかつ【オトコ】でない
    SIF TALENT:母乳体質  || IS_小柄(TARGET) || IS_貧乳(TARGET) || IS_MALE(TARGET)
        RETURN 0
    ;更に［Ｂ感度］５以上かつ【巨乳】か【爆乳】で触手調教や獣姦でなく
    SIF ABL:Ｂ感覚 <= 4 || !IS_チチユレ(TARGET) || TEQUIP:触手召喚 || TEQUIP:獣姦プレイ
        RETURN 0
    ;調教者が【幼稚】か【幼児退行】か【未熟】
    SIF !TALENT:PLAYER:幼稚 && !TALENT:PLAYER:幼児退行 && !TALENT:PLAYER:未熟
        RETURN 0
    ;「調教対象」から「調教者」への関係が150以上か主人プレイで愛
    SIF RELATION:(NO:PLAYER) < 150 && (PLAYER != MASTER || !TALENT:恋心)
        RETURN 0
    PRINTFORML %NAME:PLAYER%に乳房を吸われる内に、%NAME:TARGET%は母乳が出るようになった…
    TALENT:母乳体質 = 1

    RETURN 1

;-------------------------------------------------
;精通
;-------------------------------------------------
@EVENT_SEITSU
    ;【オトコ】か【ふたなり】であり【未熟】
    SIF !HAVE_PENIS(TARGET) || !TALENT:未熟
        RETURN 0
    ;更に［Ｃ感度］５以上で触手調教や獣姦でなく
    SIF ABL:Ｃ感覚 <= 4 || TEQUIP:触手召喚 || TEQUIP:獣姦プレイ
        RETURN 0
    ;「調教対象」から「調教者」への関係が150以上
    SIF RELATION:TARGET:(NO:PLAYER) < 150
        RETURN 0
    PRINTFORML %NAME:PLAYER%に%CSTR:男性器呼び方%を吸われる内に、%NAME:TARGET%は精通を迎えた…
    TALENT:未熟 = 0

    RETURN 1

;-------------------------------------------------
;SOURCEの上昇を計算する関数
;-------------------------------------------------
@CALC_刺激SOURCE(ARGS, CHARANO, TYPE)
#FUNCTION
#DIM CHARANO
#DIM TYPE
	VARSET RESULT
	SELECTCASE ARGS
		CASE "Ｃ刺激"
			RESULT = CALC_刺激(ABL:CHARANO:Ｃ感覚, TYPE)
            ;直接刺激できないとペナルティ
            SIF !CHECK_CLO("ずらし可", CHARANO)
                RESULT = MULTIPLY(LOCAL, 40 + ABL:CHARANO:Ｃ感覚*5)
		CASE "Ｖ刺激"
			RESULT = CALC_刺激(ABL:CHARANO:Ｖ感覚, TYPE)
		CASE "Ａ刺激"
			RESULT = CALC_刺激(ABL:CHARANO:Ａ感覚, TYPE)
		CASE "Ｂ刺激"
			RESULT = CALC_刺激(ABL:CHARANO:Ｂ感覚, TYPE)
            ;直接刺激できないとペナルティ
            SIF !CHECK_CLO("はだけ可", CHARANO) && !CHECK_CLO("谷間露出", CHARANO) && !CHECK_CLO("乳房露出", CHARANO) 
                RESULT = MULTIPLY(LOCAL, 40 + ABL:CHARANO:Ｂ感覚*5)
	ENDSELECT
	RETURNF RESULT

@CALC_刺激(感覚,TYPE)
#FUNCTION
#DIM 感覚
#DIM TYPE
	;上昇曲線としてはへの字型にする
	SELECTCASE 感覚
		CASE 0
			RESULT = 100
		CASE 1 TO 4
			RESULT = 感覚*200
		CASE 5 TO 10
			RESULT = 800 + (感覚 - 4)*100
		CASEELSE
			RESULT = 1400 + (感覚 - 10)*10
	ENDSELECT

	SELECTCASE TYPE
		;道具の使用（基本値）
		CASE 刺激_補正なし
		;舌や指などで刺激(緩やかな上昇)
		CASE 刺激_緩やか
			RESULT = MULTIPLY(RESULT, 40 + MIN(感覚, 10)*5)
		;素股系(刺激は副産物。弱め)
		CASE 刺激_弱め
			RESULT = MULTIPLY(RESULT, 20)
		;逆セックス系(強め)
		CASE 刺激_強め
			RESULT = MULTIPLY(RESULT, 5 + MIN(感覚, 10)*15)
		;逆アナル系(強め)
		CASE 刺激_急激
			RESULT = MULTIPLY(RESULT, MAX(MIN(感覚, 10)*50 - 200, (MIN(感覚, 10) + 1)*5) )
	ENDSELECT
	RETURNF RESULT

;-------------------------------------------------
;PLAYERCHARAの屈従を計算する関数
;RESULT:PLAYERCHARAの屈従
;-------------------------------------------------
@CALC_屈従(PLAYERCHARA,TARGETCHARA,MODE,TYPE)
#FUNCTION
#DIM PLAYERCHARA
#DIM TARGETCHARA
#DIM MODE
#DIM TYPE
    VARSET RESULT
	SELECTCASE MODE
		;PLAYERCHARAが主導的にTARGETCHARAにコマンドを実行したときもしくはPLAYERCHARAがTARGETCHARAにPLAYERCHARAに奉仕するように命令したとき
		CASE 主導_調教
            ;PLAYERCHARAが主導的でもマゾければ勝手に奉仕する屈従感じるよねってことで
            IF TALENT:PLAYERCHARA:マゾ
                RESULT += 50 * LIMIT(ABL:PLAYERCHARA:マゾっ気,1,5) + 100 * LIMIT(ABL:PLAYERCHARA:マゾっ気 - 3,0,7)
                RESULT += 10 * LIMIT(ABL:TARGETCHARA:サドっ気,0,5) + 10 * LIMIT(ABL:TARGETCHARA:サドっ気 - 3,0,7)
                ;隠れマゾは半減しとく
                SIF TALENT:PLAYERCHARA:マゾ < 0
                    RESULT = MULTIPLY(RESULT, 50) 
            ;それ以外の場合自発的にPLAYERが実行するのでPLAYERCHARA屈従はなし
            ELSE
            ENDIF
		;PLAYERCHARAがTARGETCHARAに命令されて奉仕したときもしくはPLAYERCHARAが主導的なTARGETCHARAにコマンドを実行されたとき
        ;要するに上の逆
		CASE 主導_被調教
            ;マゾっ気
            RESULT += 100 * LIMIT(ABL:PLAYERCHARA:マゾっ気,1,5) + 100 * LIMIT(ABL:PLAYERCHARA:マゾっ気 - 3,0,7)
            RESULT += 10 * LIMIT(ABL:TARGETCHARA:サドっ気,0,5) + 10 * LIMIT(ABL:TARGETCHARA:サドっ気 - 3,0,7)
            ;サドは多分マゾの命令をおねだり的に勝手に解釈するんじゃないかなということで下げる
            IF ABL:TARGETCHARA:マゾっ気 && TALENT:PLAYERCHARA:サド
                RESULT = MULTIPLY(RESULT, 50) 
            ;サド同志は屈辱的
            ELSEIF TALENT:PLAYERCHARA:サド && TALENT:TARGETCHARA:サド
                RESULT = 100 + MULTIPLY(RESULT, 120) 
            ENDIF
		;PLAYERCHARAがMASTERに命令されて別のTARGETCHARAにコマンドを実行したとき
        ;対応するTARGETCHARAのモードは主導_被調教
		CASE 主導_被命令
            ;マゾっ気
            RESULT += 100 * LIMIT(ABL:PLAYERCHARA:マゾっ気,1,5) + 100 * LIMIT(ABL:PLAYERCHARA:マゾっ気 - 3,0,7)
            RESULT += 10 * LIMIT(ABL:MASTER:サドっ気,0,5) + 10 * LIMIT(ABL:MASTER:サドっ気 - 3,0,7)
            ;PLAYERCHARAからMASTERへの相性を見る
            SELECTCASE RELATION:PLAYERCHARA:(NO:MASTER)
                CASE IS < 50
                    TIMES RESULT, 0.5
                CASE IS < 90
                    TIMES RESULT, 0.75
                CASE IS < 110
                    TIMES RESULT, 1
                CASE IS < 150
                    TIMES RESULT, 1.25
                CASE IS < 200
                    TIMES RESULT, 1.5
                CASE IS < 300
                    TIMES RESULT, 1.75
                CASEELSE
                    TIMES RESULT, 2
            ENDSELECT

            IF TALENT:PLAYERCHARA:マゾ > 0
                RESULT = MULTIPLY(RESULT, 150) 
            ;隠れマゾ
            ELSEIF TALENT:PLAYERCHARA:マゾ < 0
                RESULT = MULTIPLY(RESULT, 120) 
            ;サドはそれほどでもない
            IF TALENT:PLAYERCHARA:サド > 0
                RESULT = MULTIPLY(RESULT, 70) 
            ;隠れサド
            ELSEIF TALENT:PLAYERCHARA:サド < 0
                RESULT = MULTIPLY(RESULT, 90) 
            ENDIF

	ENDSELECT
	SELECTCASE TYPE
		;基本値
		CASE 刺激_補正なし
		;緩やかな上昇
		CASE 刺激_緩やか
			RESULT = MULTIPLY(RESULT, 40 + MIN(ABL:PLAYERCHARA:マゾっ気, 10)*5)
			RESULT:1 = MULTIPLY(RESULT:1, 40 + MIN(ABL:TARGETCHARA:マゾっ気, 10)*5)
		;弱め
		CASE 刺激_弱め
			RESULT = MULTIPLY(RESULT, 20)
			RESULT:1 = MULTIPLY(RESULT:1, 20)
		;強め
		CASE 刺激_強め
			RESULT = MULTIPLY(RESULT, 5 + MIN(ABL:PLAYERCHARA:マゾっ気, 10)*15)
			RESULT:1 = MULTIPLY(RESULT:1, 5 + MIN(ABL:TARGETCHARA:マゾっ気, 10)*15)
		;急激
		CASE 刺激_急激
			RESULT = MULTIPLY(RESULT, MAX(MIN(ABL:PLAYERCHARA:マゾっ気, 10)*50 - 200, (MIN(ABL:PLAYERCHARA:マゾっ気, 10) + 1)*5) )
			RESULT:1 = MULTIPLY(RESULT:1, MAX(MIN(ABL:TARGETCHARA:マゾっ気, 10)*50 - 200, (MIN(ABL:TARGETCHARA:マゾっ気, 10) + 1)*5) )
	ENDSELECT
	RETURNF RESULT

;-------------------------------------------------
;PLAYERCHARAの達成を計算する関数
;RESULT:PLAYERCHARAの達成
;-------------------------------------------------
@CALC_達成(PLAYERCHARA,TARGETCHARA,MODE,TYPE)
#FUNCTION
#DIM PLAYERCHARA
#DIM TARGETCHARA
#DIM MODE
#DIM TYPE
    VARSET RESULT
	SELECTCASE MODE
		;PLAYERCHARAが主導的にTARGETCHARAにコマンドを実行したときもしくはPLAYERCHARAがTARGETCHARAにPLAYERCHARAに奉仕するように命令したとき
		CASE 主導_調教
            IF TALENT:PLAYERCHARA:サド
                RESULT += 50 * LIMIT(ABL:PLAYERCHARA:サドっ気,1,5) + 100 * LIMIT(ABL:PLAYERCHARA:サドっ気 - 3,0,7)
                ;隠れサドは半減しとく
                SIF TALENT:PLAYERCHARA:サド < 0
                    RESULT = MULTIPLY(RESULT, 50) 
            ;それ以外の場合自発的にPLAYERが実行するので屈従はなし
            ELSE
            ENDIF
		;PLAYERCHARAがTARGETCHARAに命令されて奉仕したときもしくはPLAYERCHARAが主導的なTARGETCHARAにコマンドを実行されたとき
        ;要するに上の逆
		CASE 主導_被調教
            ;マゾっ気
            RESULT += 100 * LIMIT(ABL:PLAYERCHARA:サドっ気,1,5) + 100 * LIMIT(ABL:TARGETCHARA:サドっ気 - 3,0,7)
            ;サドは多分マゾの命令をおねだり的に勝手に解釈するんじゃないかなということで下げる
            IF TALENT:TARGETCHARA:マゾ && TALENT:PLAYERCHARA:サド
                RESULT = MULTIPLY(RESULT, 50) 
                ;隠れサドは半減しとく
                SIF TALENT:PLAYERCHARA:サド < 0
                    RESULT = MULTIPLY(RESULT, 50) 
                ;隠れマゾは半減しとく
                SIF TALENT:PLAYERCHARA:マゾ < 0
                    RESULT = MULTIPLY(RESULT, 50) 
            ENDIF
		;PLAYERがMASTERに命令されて別のTARGETにコマンドを実行したとき
        ;対応するTARGETのモードは主導_被調教
		CASE 主導_被命令
			RESULT = MULTIPLY(LOCAL, 20)
	ENDSELECT
	SELECTCASE TYPE
		;基本値
		CASE 刺激_補正なし
		;緩やかな上昇
		CASE 刺激_緩やか
			RESULT = MULTIPLY(RESULT, 40 + MIN(ABL:PLAYERCHARA:マゾっ気, 10)*5)
			RESULT:1 = MULTIPLY(RESULT:1, 40 + MIN(ABL:TARGETCHARA:マゾっ気, 10)*5)
		;弱め
		CASE 刺激_弱め
			RESULT = MULTIPLY(RESULT, 20)
			RESULT:1 = MULTIPLY(RESULT:1, 20)
		;強め
		CASE 刺激_強め
			RESULT = MULTIPLY(RESULT, 5 + MIN(ABL:PLAYERCHARA:マゾっ気, 10)*15)
			RESULT:1 = MULTIPLY(RESULT:1, 5 + MIN(ABL:TARGETCHARA:マゾっ気, 10)*15)
		;急激
		CASE 刺激_急激
			RESULT = MULTIPLY(RESULT, MAX(MIN(ABL:PLAYERCHARA:マゾっ気, 10)*50 - 200, (MIN(ABL:PLAYERCHARA:マゾっ気, 10) + 1)*5) )
			RESULT:1 = MULTIPLY(RESULT:1, MAX(MIN(ABL:TARGETCHARA:マゾっ気, 10)*50 - 200, (MIN(ABL:TARGETCHARA:マゾっ気, 10) + 1)*5) )
	ENDSELECT
	RETURNF RESULT


