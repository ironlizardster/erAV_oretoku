;-------------------------------------------------
;特にコマンド側で何も特殊なことをしていないとき
;コマンド側で違うことをしたいときはCOMFコマンドID_コマンド名.ERBの中にCOM_コマンド名で実装すること
;-------------------------------------------------
@COM_DEFAULT
    CALL PRINT_TRAIN_NAME(SELECTCOM)
    CALL TRAIN_MESSAGE
    SIF CANCEL_CHECK()
        RETURN 0

    STR:前回コマンド = %STR:今回コマンド%
    RETURN 1

;-------------------------------------------------
;全部の@COMABLEを一斉に管理する時に使用する式中関数
;押し倒しなど、登場頻度が非常に多いものについてのみ扱う
;バイブなどの装備品が解除できるかどうかの判定は、この判定よりも優先度が高いことに注意
;なお、NEXTCOMの時には@COM_ABLEを通らない。
;0がコマンド実行可能
;ARG:コマンド
;-------------------------------------------------
@COMABLE_DEF(ARG)
#FUNCTION    
    SIF TARGET < 0 || PLAYER < 0 || TARGET >= CHARANUM || PLAYER >= CHARANUM || TRAINNAME_EX(ARG) == ""
        RETURNF 1
        
    ;TARGETのコマンド禁止処置
    SIF DITEMTYPE:ARG > 0
        RETURNF 1

    ;PLAYERのコマンド禁止処置
    SELECTCASE REVCOM(ARG,PLAYER)
    ;コマンド立場逆転でも変わらないものは問題ない
    CASE ARG
    CASEELSE
        SIF DITEMTYPE:PLAYER:RESULT > 0
            RETURNF 1
    ENDSELECT

    ;コマンド禁止フィルタ
    SIF DITEMTYPE:0:ARG == 2 && CONFIG("コマンドフィルタ") == 0
        RETURNF 1

    ;各種フィルタ
    IF TALENT:処女 && CONFIG("Ｖ調教フィルタ")
        SIF TRAIN_GENRE("Ｖ調教", ARG,TARGET)
            RETURNF 1
    ENDIF
    IF CONFIG("Ａ調教フィルタ")
        SIF TRAIN_GENRE("Ａ調教", ARG,TARGET)
            RETURNF 1
    ENDIF
    IF CONFIG("逆挿入フィルタ")
        SIF TRAIN_GENRE("逆挿入", ARG,TARGET)
            RETURNF 1
    ENDIF
    IF CONFIG("道具調教フィルタ")
        SIF TRAIN_GENRE("道具調教", ARG,TARGET)
            RETURNF 1
    ENDIF
    IF CONFIG("ハード調教フィルタ")
        SIF TRAIN_GENRE("ハード調教", ARG,TARGET)
            RETURNF 1
    ENDIF

    IF CONFIG("立位")
        SIF TRAIN_GENRE("立位可能", ARG,TARGET) == 0
            RETURNF 1
        IF TRAIN_GENRE("駅弁挿入", ARG,TARGET)
            SIF SIZE("ペニス", PLAYER) == 0
                RETURNF 1
            SIF TALENT:小柄 == 0 && TALENT:PLAYER:力持ち == 0
                RETURNF 1
        ENDIF

        SELECTCASE ARG
            ;駅弁挿入中は幾つかの愛撫コマンドをすると終了してしまうため、一見可能かよく分からないものは禁止しておく
            ;駅弁のみ禁止
            CASE TNUM("自慰")
                SIF INSERT("駅弁")
                    RETURNF 1
            ;両駅弁共に禁止
            CASE TNUM("アナル愛撫"), TNUM("胸愛撫"), TNUM("アソコ愛撫"), TNUM("指挿入れ")
                SIF INSERT("駅弁") || INSERT("背面駅弁")
                    RETURNF 1
            ;禁止体位など
            CASE TNUM("正常位"), TNUM("アナル正常位")
                SIF INSERT("背面座位")
                    RETURNF 1
            CASE TNUM("後背位"), TNUM("アナル後背位")
                SIF INSERT("対面座位")
                    RETURNF 1
            CASE TNUM("対面座位"), TNUM("アナル対面座位")
                SIF INSERT("後背位") || INSERT("背面座位")
                    RETURNF 1
            CASE TNUM("背面座位"), TNUM("アナル背面座位")
                SIF INSERT("正常位") || INSERT("対面座位")
                    RETURNF 1
        ENDSELECT
    ENDIF

    ;場所による制限
    SELECTCASE TRAINNAME_EX(ARG)
    CASE "お風呂場プレイ"
        SIF PLACE("お風呂場") == 0
            RETURNF 1
    CASE "新妻プレイ"
        SIF PLACE("自宅") == 0
            RETURNF 1
    CASE "室内露出プレイ"
        SIF PLACE("自宅") == 0 && PLACE("部室") == 0
            RETURNF 1
    ENDSELECT

    ;プレイの制限
    ;受け手が制限されている
    IF PLAYER != MASTER && COND("身嗜み：性行為の制限")
        SELECTCASE ARG
        CASE TNUM("正常位") TO TNUM("正常位") + 9
            SIF COND("身嗜み：Ｖ独占")
                RETURNF 1
        CASE TNUM("アナル正常位") TO TNUM("アナル正常位") + 9
            SIF COND("身嗜み：Ａ独占")
                RETURNF 1
        CASE TNUM("フェラチオ"), TNUM("アナル奉仕"), TNUM("奉仕クンニ"), TNUM("シックスナイン"), TNUM("イラマチオ"), TNUM("ディープスロート")
            SIF COND("身嗜み：口独占")
                RETURNF 1
        CASE TNUM("キスする")
            SIF COND("身嗜み：キス独占")
                RETURNF 1
        CASE TNUM("正常位奉仕") TO TNUM("正常位奉仕") + 9
            SIF HAVE_PENIS(TARGET) && COND("身嗜み：Ｐ独占")
                RETURNF 1
        ENDSELECT
    ENDIF
    ;攻め手が制限されている
    IF COND("身嗜み：性行為の制限", PLAYER)
        SELECTCASE ARG
        CASE TNUM("正常位奉仕") TO TNUM("正常位奉仕") + 4
            SIF COND("身嗜み：Ｖ独占", PLAYER)
                RETURNF 1
        CASE TNUM("Ａ正常位奉仕") TO TNUM("正常位奉仕") + 4
            SIF COND("身嗜み：Ａ独占", PLAYER)
                RETURNF 1
        CASE TNUM("クンニ"), TNUM("フェラする"), TNUM("アナル舐め")
            SIF COND("身嗜み：口独占", PLAYER)
                RETURNF 1
        CASE TNUM("キスする")
            SIF COND("身嗜み：キス独占", PLAYER)
                RETURNF 1
        CASE TNUM("正常位") TO TNUM("正常位") + 19, TNUM("イラマチオ"), TNUM("ディープスロート")
            SIF HAVE_PENIS(PLAYER) && COND("身嗜み：Ｐ独占", PLAYER)
                RETURNF 1
        ENDSELECT
    ENDIF

    ;一部ハードコマンドは屈服刻印やマゾっ気が必要(実行条件があるものは除く)
    SELECTCASE ARG
        CASE TNUM("鼻フック"), TNUM("アイマスク"), TNUM("口枷")
            SIF MARK:屈服刻印 == 0 && ABL:マゾっ気 == 0 && ABL:信頼 < 5 && ABL:欲望 < 5 && TALENT:倒錯的 == 0
                RETURNF 1
        CASE TNUM("拘束する")
            SIF MARK:屈服刻印 < 1 && ABL:マゾっ気 < 1 && TALENT:倒錯的 == 0
                RETURNF 1
        CASE TNUM("浣腸")
            SIF MARK:屈服刻印 < 2 && ABL:マゾっ気 < 2
                RETURNF 1
    ENDSELECT

    ;挿入系コマンドの一括処理や汚れなどによるプレイの制限
    SELECTCASE ARG
        CASE TNUM("クンニ"), TNUM("フェラする"), TNUM("キスする"), TNUM("アナル舐め"), TNUM("手コキする"), TNUM("パイズリする"), TNUM("シックスナイン")
            ;女王様プレイor押し倒しなら汚れで文句は言えない
            IF TEQUIP:PLAYER:女王様プレイ == 0 && TEQUIP:押し倒し == 0
                IF TALENT:PLAYER:汚臭鈍感 || TALENT:PLAYER:汚れ無視
                ;あなたの性癖とTARGETの属性が２個以上合致
                ;ELSEIF PLAYER == MASTER && (CALCF("属性突かれ", TARGET) >= 2 || TALENT:相思相愛)
                ELSEIF PLAYER == MASTER
                ELSEIF PLAYER == ASSI && ABL:ASSI:信頼 >= 4
                ELSE
                    LOCAL = 0
                    SELECTCASE ARG
                    CASE TNUM("クンニ")
                        LOCAL = STAIN:Ｖ
                    CASE TNUM("フェラする"), TNUM("手コキする"), TNUM("パイズリする")
                        LOCAL = STAIN:Ｐ
                    CASE TNUM("キスする")
                        LOCAL = STAIN:Ｍ
                    CASE TNUM("アナル舐め")
                        LOCAL = STAIN:Ａ
                    CASE TNUM("シックスナイン")
                        SIF TALENT:オトコ == 0
                            LOCAL |= STAIN:Ｖ
                        SIF HAVE_PENIS(TARGET)
                            LOCAL |= STAIN:Ｐ
                    ENDSELECT

                    SIF CHECK_STAIN(LOCAL, "破瓜の血")
                        RETURNF 1
                    IF CHECK_STAIN(LOCAL, "Ａ") && COND("アナルに弱い", PLAYER) == 0
                        SIF TEQUIP:お風呂上り == 0 || ARG != 9
                            RETURNF 1
                    ENDIF
                    IF TALENT:PLAYER:オトコ && TALENT:PLAYER:両刀 == 0 && CHECK_STAIN(LOCAL, "Ｐ") && COND("♂に弱い", PLAYER) == 0
                        SIF TEQUIP:お風呂上り == 0 || ARG != 4
                            RETURNF 1
                    ENDIF
                    IF TALENT:PLAYER:オンナ && TALENT:PLAYER:両刀 == 0 && CHECK_STAIN(LOCAL, "Ｖ") && COND("♀に弱い", PLAYER) == 0
                        SIF TEQUIP:お風呂上り == 0 || ARG != 1
                            RETURNF 1
                    ENDIF
                    ;SIF ABL:PLAYER:精液中毒 == 0 && TALENT:PLAYER:両刀 == 0 && CHECK_STAIN(LOCAL, "精液")
                    ;	RETURNF 1
                ENDIF
            ENDIF
        ;Ｖインサートコマンド
        CASE TNUM("正常位") TO TNUM("正常位") + 9
            IF COND("調教中") && CONFIG("準備不足フィルタ")
                SIF CHOSECOMS("Ｖ挿入") == 0 && COND("Ｖ潤十分") == 0
                    RETURNF 1
            ENDIF
            SIF USE_V(TARGET) == 0 || TEQUIP:PLAYER:カテーテル
                RETURNF 1
            ;調教者がペニスあり、もしくはペニスバンドがないとダメ
            SIF HAVE_PENIS(PLAYER) == 0 && COND("ペニバン", PLAYER) == 0
                RETURNF 1
            ;調教中でないなら2LV以上でかいペニスは避ける
            SIF COND("調教中") == 0
                RETURNF 1
            IF TEQUIP:押し倒し
                SIF TALENT:淫乱 + !TALENT:恋慕
                    RETURNF 1
                ;押し倒しは生セックス！
                SIF COND("女性主導生セックス") == 0
                    RETURNF 1
                ;あなたが恍惚＆まだインサートした事が無いならしてこない
                SIF STATE("恍惚", PLAYER) && FIRSTCOMS("Ｖ挿入") == 0
                    RETURNF 1
                ;あなたが骨抜き＆まだインサートした事が無いならしてこない
                SIF STATE("骨抜き", PLAYER) && FIRSTCOMS("Ｖ挿入") == 0
                    RETURNF 1
            ENDIF
        ;Ａインサートコマンド
        CASE TNUM("アナル正常位") TO TNUM("アナル正常位") + 9
            IF COND("調教中") && CONFIG("準備不足フィルタ")
                SIF CHOSECOMS("Ａ挿入") == 0 && COND("Ａ潤十分") == 0
                    RETURNF 1
            ENDIF
            SIF USE_A(TARGET) == 0 || TEQUIP:PLAYER:カテーテル
                RETURNF 1
            ;調教者がペニスあり、もしくはペニスバンドがないとダメ
            SIF HAVE_PENIS(PLAYER) == 0 && COND("ペニバン", PLAYER) == 0
                RETURNF 1
            ;調教中でないなら2LV以上でかいペニスは避ける
            SIF COND("調教中") == 0
                RETURNF 1
            SIF TEQUIP:押し倒し && !TALENT:恋慕
                RETURNF 1
            ;合意or拘束などが必要
            IF COND("合意：アナルセックス") == 0 && TEQUIP:拘束 == 0
                SIF COND("なし崩しでＡ挿入可") == 0
                    RETURNF 1
                ;あなたが恍惚＆まだインサートした事が無いならしてこない
                SIF STATE("恍惚", PLAYER) && FIRSTCOMS("Ａ挿入") == 0
                    RETURNF 1
                ;あなたが骨抜き＆まだインサートした事が無いならしてこない
                SIF STATE("骨抜き", PLAYER) && FIRSTCOMS("Ａ挿入") == 0
                    RETURNF 1
            ENDIF

            ;調教相手がペニスあり、もしくはペニスバンドがないとダメ
            SIF PENIS(TARGET) == 0 && COND("ペニバン") == 0
                RETURNF 1
            SIF TEQUIP:カテーテル
                RETURNF 1
        ;フィスト
        CASE TNUM("フィストファック"), TNUM("アナルフィスト"), TNUM("両穴フィスト")
            ;手が使えないとダメ
            SIF COND("指の使用", PLAYER) == 0
                RETURNF 1
            IF ARG == TNUM("フィストファック")
                SIF USE_V(TARGET) == 0
                    RETURNF 1
                ;処女はダメ
                SIF TALENT:処女 == 1
                    RETURNF 1
            ELSEIF ARG == TNUM("アナルフィスト")
                SIF USE_A(TARGET) == 0
                    RETURNF 1
                ;液剤多めの浣腸中
                SIF COND("液体浣腸")
                    RETURNF 1
            ELSEIF ARG == TNUM("両穴フィスト")
                SIF USE_V(TARGET) == 0
                    RETURNF 1
                SIF TALENT:処女 == 1
                    RETURNF 1
                SIF USE_A(TARGET) == 0
                    RETURNF 1
                ;液剤多めの浣腸中
                SIF COND("液体浣腸")
                    RETURNF 1
            ENDIF
        ;助手が必須のコマンドは、助手が居なかったりダウンしてたらダメ
        CASE TNUM("二人に押し倒される")
            SIF ASSI <= 0 || STATE("撃沈", ASSI) || TEQUIP:ビデオカメラ
                RETURNF 1
            SIF COND("押し倒し騎乗位実行可能", ASSI) == 0
                RETURNF 1
        CASE TNUM("抱きしめる")
            ;手が使えないとダメ
            SIF COND("指の使用", PLAYER) == 0
                RETURNF 1
    ENDSELECT

    ;服装による制限
    SELECTCASE ARG
        CASE TNUM("愛撫"), TNUM("胸の谷間を犯す"), TNUM("ニプルファック"), TNUM("パイズリ"), TNUM("ぱふぱふ")
            SIF CHECK_SHIRT("鎧") && CHECK_CLO("谷間露出") + CHECK_CLO("乳首露出") + CHECK_CLO("はだけ可") == 0
                RETURNF 1
    ENDSELECT


    ;手が拘束されている
    IF COND("指の使用") == 0
        SELECTCASE ARG
            CASE TNUM("着せ替え")
                SIF TEQUIP:押し倒し
                    RETURNF 1
            CASE TNUM("自慰"), TNUM("くぱぁさせる"), TNUM("Ａくぱぁさせる"), TNUM("手淫"), TNUM("パイズリ"), TNUM("泡踊り"), TNUM("ぱんつコキ"), TNUM("足舐め奉仕"), TNUM("ぱふぱふ") TO TNUM("ぱふぱふ") + 3, TNUM("お風呂場プレイ"), TNUM("新妻プレイ"), TNUM("押し倒される") TO TNUM("押し倒される") + 2
                RETURNF 1
        ENDSELECT
    ENDIF
    ;足が拘束されている
    IF COND("脚の使用") == 0
        SELECTCASE ARG
            CASE TNUM("泡踊り"), TNUM("足コキ"), TNUM("正常位奉仕") TO TNUM("正常位奉仕") + 9, TNUM("野外プレイ") TO TNUM("室内露出プレイ"), TNUM("押し倒される"), TNUM("二人に押し倒される")
                RETURNF 1
        ENDSELECT
    ENDIF
    ;拘束
    IF TEQUIP:拘束
        ;縄：逆海老
        IF BIND("縄：逆海老", TEQUIP:拘束)
            SELECTCASE ARG
                CASE TNUM("後背位"), TNUM("挿入Ｇスポ責め") TO TNUM("挿入Ｇスポ責め") + 3, TNUM("アナル後背位")
                CASE TNUM("クンニ"), TNUM("アナル舐め"), TNUM("正常位") TO TNUM("正常位") + 19, TNUM("剃毛"), TNUM("ピアッシング")
                    RETURNF 1
            ENDSELECT
        ;縄：足吊り
        ELSEIF BIND("縄：足吊り", TEQUIP:拘束)
            SELECTCASE ARG
                ;正常位はおかしい気もするがまぁ前からの時ということで
                CASE TNUM("正常位"), TNUM("後背位"), TNUM("挿入Ｇスポ責め") TO TNUM("挿入Ｇスポ責め") + 3, TNUM("アナル正常位"), TNUM("アナル後背位")
                CASE TNUM("正常位") TO TNUM("正常位") + 19, TNUM("素股"), TNUM("シックスナイン"), TNUM("正常位奉仕"), TNUM("後背位奉仕"), TNUM("Ａ正常位奉仕"), TNUM("Ａ後背位奉仕")
                    RETURNF 1
            ENDSELECT
        ;縄
        ELSEIF BIND("縄", TEQUIP:拘束)
            SELECTCASE ARG
                CASE TNUM("貝合わせ"), TNUM("素股"), TNUM("シックスナイン"), TNUM("正常位奉仕"), TNUM("後背位奉仕"), TNUM("Ａ正常位奉仕"), TNUM("Ａ後背位奉仕")
                    RETURNF 1
            ENDSELECT
        ;拘束テーブル
        ELSEIF BIND("四つん這い", TEQUIP:拘束)
            SELECTCASE ARG
                CASE TNUM("後背位"), TNUM("挿入Ｇスポ責め") TO TNUM("挿入Ｇスポ責め") + 3, TNUM("アナル後背位")
                CASE TNUM("正常位") TO TNUM("正常位") + 19, TNUM("素股"), TNUM("正常位奉仕") TO TNUM("正常位奉仕") + 9, TNUM("野外プレイ")
                    RETURNF 1
            ENDSELECT
        ;拘束ベッド
        ELSEIF BIND("ベッド", TEQUIP:拘束)
            SELECTCASE ARG
                CASE TNUM("正常位"), TNUM("挿入Ｇスポ責め") TO TNUM("挿入Ｇスポ責め") + 3, TNUM("アナル正常位"), TNUM("騎乗位で犯す"), TNUM("Ａ騎乗位で犯す")
                CASE TNUM("正常位") TO TNUM("正常位") + 19, TNUM("素股"), TNUM("シックスナイン"), TNUM("正常位奉仕") TO TNUM("正常位奉仕") + 9, TNUM("野外プレイ")
                    RETURNF 1
            ENDSELECT
        ;M字拘束台
        ELSEIF BIND("Ｍ字開脚", TEQUIP:拘束)
            SELECTCASE ARG
                CASE TNUM("正常位"), TNUM("アナル正常位"), 
                CASE TNUM("正常位") TO TNUM("正常位") + 19, TNUM("フェラチオ"), TNUM("素股"), TNUM("奉仕クンニ"), TNUM("シックスナイン"), TNUM("正常位奉仕") TO TNUM("正常位奉仕") + 9, TNUM("イラマチオ"), TNUM("ディープスロート"), TNUM("野外プレイ")
                    RETURNF 1
            ENDSELECT
        ;ミスリルチェーン(吊り)
        ELSEIF BIND("吊り", TEQUIP:拘束)
            SELECTCASE ARG
                CASE TNUM("正常位"), TNUM("後背位"), TNUM("アナル正常位"), TNUM("アナル後背位")
                CASE TNUM("正常位") TO TNUM("正常位") + 19, TNUM("フェラチオ"), TNUM("素股"), TNUM("奉仕クンニ"), TNUM("シックスナイン"), TNUM("正常位奉仕") TO TNUM("正常位奉仕") + 9, TNUM("イラマチオ"), TNUM("ピアッシング"), TNUM("ディープスロート"), TNUM("野外プレイ")
                    RETURNF 1
            ENDSELECT
        ENDIF
    ENDIF

    IF TEQUIP:押し倒し
        IF COND("主導権無し")
            SELECTCASE ARG
                CASE TNUM("二人に押し倒される"), TNUM("もがく"), TNUM("なすがまま"), TNUM("相手にまかせる")
                CASEELSE
                    RETURNF 1
            ENDSELECT
        ENDIF

        SELECTCASE ARG
            ;解除のみは可能
            CASE TNUM("バイブ"), TNUM("アナルバイブ"), TNUM("アナルプラグ"), TNUM("オナホール"), TNUM("電話させる")
                SIF CHECK_TEQUIP(ARG) == 0
                    RETURNF 1
            ;実行可能なコマンド
            CASE TNUM("クンニ"), TNUM("フェラする") , TNUM("キスする"), TNUM("アナル舐め"), TNUM("パイズリする"), TNUM("騎乗位") TO TNUM("騎乗位") + 4, TNUM("アナル騎乗位"), TNUM("貝合わせ"), TNUM("ニプルファック"), TNUM("手淫") TO TNUM("シックスナイン"), TNUM("尻コキ") TO TNUM("オナホコキ"), TNUM("正常位奉仕"), TNUM("Ａ後背位奉仕"), TNUM("放尿"), TNUM("剃毛"), TNUM("ディープスロート"), TNUM("ビデオカメラ"), TNUM("着せ替え"), TNUM("二人に押し倒される"), TNUM("具現"), TNUM("もがく") TO TNUM("自慰する"), TNUM("相手にまかせる")

            CASEELSE
                RETURNF 1
        ENDSELECT
        ;Ｗ押し倒し
        IF TEQUIP:Ｗ押し倒し
            SELECTCASE ARG
                CASE TNUM("愛撫"), TNUM("手コキする") TO TNUM("足コキする"), TNUM("貝合わせ"), TNUM("ニプルファック"), TNUM("シックスナイン"), TNUM("オナホコキ"), TNUM("放尿"), TNUM("剃毛"), TNUM("ディープスロート"), TNUM("着せ替え"), TNUM("二人に押し倒される"), TNUM("電話させる"), TNUM("媚薬"), TNUM("自慰する")
                    RETURNF 1
            ENDSELECT
        ENDIF
    ENDIF

    ;野外、室内露出、お風呂など部屋の外でのプレイの制限
    IF TEQUIP:野外プレイ
        SELECTCASE ARG
            ;通常は実行不可なグループの中で例外的に実行可能なコマンド
            CASE TNUM("素股"), TNUM("尻コキ"), TNUM("スパンキング"), TNUM("何もしない"), TNUM("放尿"), TNUM("ディープスロート")
            ;解除のみは可能
            CASE TNUM("バイブ"), TNUM("アナルバイブ"), TNUM("アナルプラグ"), TNUM("オナホール"), TNUM("アイマスク") TO TNUM("浣腸")
                SIF CHECK_TEQUIP(ARG) == 0
                    RETURNF 1
            ;実行不可能なコマンド
            CASE TNUM("ローター") TO TNUM("ローター") + 9, TNUM("素股") TO TNUM("素股") + 19, TNUM("正常位奉仕") TO TNUM("正常位奉仕") + 9, TNUM("スパンキング") TO TNUM("写真撮影") TNUM("お風呂場プレイ") TO TNUM("室内露出プレイ")
                RETURNF 1
        ENDSELECT
    ENDIF
    IF TEQUIP:お風呂プレイ
        SELECTCASE ARG
            ;解除のみは可能
            CASE TNUM("アイマスク") TO TNUM("口枷"), TNUM("新妻プレイ")
                SIF CHECK_TEQUIP(ARG) == 0
                    RETURNF 1
            ;実行不可能なコマンド
            CASE TNUM("鼻フック") TO TNUM("口枷"), TNUM("新妻プレイ"), TNUM("室内露出プレイ"), TNUM("電話させる")
                RETURNF 1
        ENDSELECT
    ENDIF
    IF TEQUIP:室内露出プレイ
        SELECTCASE ARG
            ;実行不可能なコマンド
            CASE TNUM("野外プレイ") TO TNUM("新妻プレイ")
                RETURNF 1
