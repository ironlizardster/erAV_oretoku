;-------------------------------------------------
;足コキ実行判定
;-------------------------------------------------
@COMABLE_足コキ
#FUNCTION
    ;足コキ実行判定
    RESULT = COMABLE_DEF(TNUM("足コキ")) && COND("足の使用", PLAYER)
    RETURNF RESULT


;-------------------------------------------------
;調教時メッセージ
;-------------------------------------------------
@TRAIN_MESSAGE_COM_足コキ
    PRINTFORM %CALLNAME:PLAYER%は%CALLNAME:TARGET%のペニスを
    IF TALENT:PLAYER:小悪魔 && (CFLAG:PLAYER:着衣状態 & 1) && HAVE_VAGINA(PLAYER)
        SIF PALAM:PLAYER:潤滑 >= PALAMLV:4
            PRINT 愛液で陰裂がくっきりと浮き出た
        CALL PRINT_UNDERWEAR_UNDER
        PRINTFORML を挑発的に見せつけるようにしながら、
    ELSEIF TALENT:PLAYER:小悪魔 && (CFLAG:PLAYER:着衣状態 & 1) == 0 && HAVE_VAGINA(PLAYER)
        SIF PALAM:PLAYER:潤滑 >= PALAMLV:4
            PRINT 愛液でしとどに濡れ、ぱっくりと口を開いた
        SIF (CFLAG:PLAYER:ピアス状況 & 4)
            PRINTFORM 鏡合わせのようにふたつのリングピアスが輝く
        IF CFLAG:PLAYER:性器 == 0
            PRINTFORM 綺麗なサーモンピンク色の
        ELSEIF CFLAG:PLAYER:性器 == 1
            PRINTFORM ラビアが肥大化した、
        ELSEIF CFLAG:PLAYER:性器 == 2
            PRINTFORM ラビアが肥大化し淫水焼けした、
        ENDIF
        PRINTFORML
        IF FLAG:陰毛を生やす 
            IF CFLAG:PLAYER:陰毛状態 > 18
                PRINT 恥丘からアナルまで密生した陰毛に覆われた
            ELSEIF CFLAG:PLAYER:陰毛状態 > 13
                PRINT かなり濃い目のアンダーヘアが繁った
            ELSEIF CFLAG:PLAYER:陰毛状態 > 10
                PRINT 陰毛が綺麗に生えそろった
            ELSEIF CFLAG:PLAYER:陰毛状態 > 8
                PRINT うっすらと陰毛に覆われた
            ELSEIF CFLAG:PLAYER:陰毛状態 > 6
                PRINT 微かに生えかけの陰毛に覆われた
            ELSEIF CFLAG:PLAYER:陰毛状態 > 0
                PRINT つるつるの
            ENDIF
            PRINTFORM 性器を
        ELSE
            PRINTFORM 性器を
        ENDIF
        PRINTFORM 挑発的に魅せつけるようにしながら、
    ENDIF
    IF CFLAG:PLAYER:靴下着用 == - 1
        PRINTFORM 素足で
    ELSEIF CFLAG:PLAYER:靴下着用 == 0
        CALL PRINT_SHOESTYPE_MAIN
        PRINTFORM ごしに
    ENDIF
    SIF TALENT:PLAYER:サド || ABL:PLAYER:サドっ気 > 2
        PRINT 踏みつけるように
    SIF TALENT:PLAYER:恋心 || TALENT:PLAYER:淫乱
        PRINT 丹念に
    PRINTL シゴいている…

;-------------------------------------------------
;ソースの計算
;ARG:100％倍率
;-------------------------------------------------
@CALC_SOURCE_COM_足コキ(ARG=100)
    ;-------------------------------------------------
    ;足コキをされた対象
    ;-------------------------------------------------
    ;快Ｃのソース
    ;ABL:技巧をみる
    TMP_SRC:TARGET:快Ｃ += 450 + MIN(ABL:PLAYER:技巧, 5) * 550 + LIMIT(ABL:PLAYER:技巧 - 1,0,4) * 50 

    IF PLAYER == MASTER || TARGET == MASTER
        TEMP_NUM = TARGET
        SIF TARGET == MASTER
            TEMP_NUM = PLAYER
        ;ABL:従順をみる
        TMP_SRC:TARGET:快Ｃ = TMP_SRC:TARGET:快Ｃ * (MIN(ABL:TEMP_NUM:信頼, 5)*10 + 80) / 100

        ;ABL:奉仕精神をみる
        TMP_SRC:TARGET:快Ｃ = TMP_SRC:TARGET:快Ｃ * (MIN(ABL:TEMP_NUM:奉仕精神, 6)*30 + 50) / 100

        ;ABL:精液中毒をみる
        TMP_SRC:TARGET:快Ｃ = TMP_SRC:TARGET:快Ｃ * (MIN(ABL:PLAYER:精液中毒, 5)*10 + 80) / 100
        TMP_SRC:TARGET:快Ｃ = TMP_SRC:TARGET:快Ｃ * (MIN(ABL:TARGET:射精中毒, 5)*10 + 80) / 100
    ELSE
        ;TARGETからPLAYERへの相性を見る
        SELECTCASE RELATION:(NO:PLAYER)
            CASE IS < 50
                TIMES TMP_SRC:TARGET:快Ｃ , 0.5
            CASE IS < 90
                TIMES TMP_SRC:TARGET:快Ｃ , 0.75
            CASE IS < 110
                TIMES TMP_SRC:TARGET:快Ｃ , 1
            CASE IS < 150
                TIMES TMP_SRC:TARGET:快Ｃ , 1.25
            CASE IS < 200
                TIMES TMP_SRC:TARGET:快Ｃ , 1.5
            CASE IS < 300
                TIMES TMP_SRC:TARGET:快Ｃ , 1.75
            CASEELSE
                TIMES TMP_SRC:TARGET:快Ｃ , 2
        ENDSELECT
     ENDIF

    ;ABL:マゾっ気をみる
    TMP_SRC:TARGET:快Ｃ = TMP_SRC:TARGET:快Ｃ * (MIN(ABL:TARGET:マゾっ気, 5)*10 + 90) / 100

; ;プレイヤーのABL:Ｃ感覚をみる
; IF ABL:PLAYER:Ｃ感覚 == 0
; 	TIMES B , 1.00
; ELSEIF ABL:PLAYER:Ｃ感覚 == 1
; 	TIMES B , 1.50
; ELSEIF ABL:PLAYER:Ｃ感覚 == 2
; 	TIMES B , 2.00
; ELSEIF ABL:PLAYER:Ｃ感覚 == 3
; 	TIMES B , 2.50
; ELSEIF ABL:PLAYER:Ｃ感覚 == 4
; 	TIMES B , 3.50
; ELSE
; 	TIMES B , 5.00
; ENDIF

    ;奉仕者
    TMP_SRC:PLAYER:屈従 = 550
    TMP_SRC:PLAYER:逸脱 = 400

    ;ABL:奉仕精神をみる
    TMP_SRC:PLAYER:性行動 += 300 + MIN(ABL:PLAYER:奉仕精神, 5) * 50
    TMP_SRC:PLAYER:達成 += 50 + MIN(ABL:PLAYER:奉仕精神, 5) * 50 + LIMIT(ABL:PLAYER:奉仕精神 - 1,0,4) * 50 + LIMIT(ABL:PLAYER:奉仕精神 - 3,0,2) * 100 + LIMIT(ABL:PLAYER:奉仕精神 - 4,0,1) * 50
    TMP_SRC:PLAYER:不潔 += 60 + COM_汚れ(TARGET,STNNUM("ペニス"),STNNUM("アナル"),1,4) * 10

    ;ABL:技巧をみる
    SELECTCASE ABL:PLAYER:技巧
        CASE 0
            TIMES TMP_SRC:PLAYER:性行動 , 0.5
            TIMES TMP_SRC:PLAYER:達成 , 0.5
        CASE 1
            TIMES TMP_SRC:PLAYER:性行動 , 0.8
            TIMES TMP_SRC:PLAYER:達成 , 0.8
        CASE 2
            TIMES TMP_SRC:PLAYER:性行動 , 1
            TIMES TMP_SRC:PLAYER:達成 , 1
        CASE 3
            TIMES TMP_SRC:PLAYER:性行動 , 1.2
            TIMES TMP_SRC:PLAYER:達成 , 1.2
        CASE 4
            TIMES TMP_SRC:PLAYER:性行動 , 1.5
            TIMES TMP_SRC:PLAYER:達成 , 1.5
        CASEELSE
            TIMES TMP_SRC:PLAYER:性行動 , 2
            TIMES TMP_SRC:PLAYER:達成 , 2
    ENDSELECT

    ;ABL:サドっ気をみる
    TMP_SRC:PLAYER:性行動 = TMP_SRC:PLAYER:性行動 * (100+MIN(ABL:PLAYER:サドっ気, 5)*20) / 100
    TMP_SRC:PLAYER:達成 = TMP_SRC:PLAYER:達成 * (100+MIN(ABL:PLAYER:サドっ気, 5)*20) / 100

    ;ABL:奉仕精神をみる
    SELECTCASE ABL:PLAYER:奉仕精神
        CASE 0
            TIMES TMP_SRC:PLAYER:不潔 , 4.00
        CASE 1
            TIMES TMP_SRC:PLAYER:不潔 , 2.5
        CASE 2
            TIMES TMP_SRC:PLAYER:不潔 , 1.5
        CASE 3
            TIMES TMP_SRC:PLAYER:不潔 , 1
        CASE 4
            TIMES TMP_SRC:PLAYER:不潔 , 0.5
        CASEELSE
            TIMES TMP_SRC:PLAYER:不潔 , 0.1
    ENDSELECT
    
	CALL APPLY_SOURCE_RATE(ARG)

;-------------------------------------------------
;経験上昇
;ARG:100％倍率
;-------------------------------------------------
@CALC_NOWEX_COM_足コキ(ARG=100)
    NOWEX:TARGET:体力変動 += 10
    NOWEX:TARGET:気力変動 += 15
    NOWEX:PLAYER:体力変動 += 10
    NOWEX:PLAYER:気力変動 += 10

    IF TALENT:PLAYER:サド == 1 || (ABL:PLAYER:欲望 >= 3 && ABL:PLAYER:サドっ気 >= 3)
        NOWEX:PLAYER:嗜虐快楽経験 += 3
    ELSEIF ABL:PLAYER:欲望 >= 3 && ABL:PLAYER:サドっ気 >= 1
        NOWEX:PLAYER:嗜虐快楽経験 += 2
    ELSEIF ABL:PLAYER:欲望 >= 3 || ABL:PLAYER:サドっ気 >= 1
        NOWEX:PLAYER:嗜虐快楽経験 += 1
    ENDIF

    IF TALENT:マゾ == 1 || (ABL:欲望 >= 3 && ABL:マゾっ気 >= 3)
        NOWEX:被虐快楽経験 += 3
    ELSEIF ABL:欲望 >= 3 && ABL:マゾっ気 >= 1
        NOWEX:被虐快楽経験 += 2
    ELSEIF ABL:欲望 >= 3 || ABL:マゾっ気 >= 1
        NOWEX:被虐快楽経験 += 1
    ENDIF

    ;レズ経験・ホモ経験
    IF HAVE_VAGINA(TARGET) && HAVE_VAGINA(PLAYER) 
        NOWEX:レズ経験 = 3
        NOWEX:PLAYER:レズ経験 = 3
    ELSEIF IS_MALE(TARGET) && IS_MALE(PLAYER) 
        NOWEX:ＢＬ経験 = 3
        NOWEX:PLAYER:ＢＬ経験 = 3
    ENDIF

    IF CFLAG:好感度 >= 1000 && PLAYER == MASTER
        NOWEX:愛情経験 += 1
    ELSEIF CFLAG:PLAYER:好感度 >= 1000 && TARGET == MASTER
        NOWEX:PLAYER:愛情経験 += 1
    ENDIF
    
	CALL APPLY_EX_RATE(ARG)

;-------------------------------------------------
;FLAGの計算
;-------------------------------------------------
@CALC_FLAG_COM_足コキ
    SIF PLAYER == MASTER
        TCVAR:主人経験 += 1
    IF TARGET == MASTER
        TCVAR:PLAYER:主人経験 += 1
        ;屈服刻印１に相当
        TCVAR:PLAYER:屈服刻印取得 = 1
    ENDIF
    TCVAR:快楽経験 = 1
    TCVAR:PLAYER:奉仕経験 = 1
    ;-------------------------------------------------
    ;汚れ
    ;-------------------------------------------------
    ;PLAYERの足⇔TARGETのＰの汚れが移動
    IF HAVE_PENIS(TARGET)
        STAIN:PLAYER:足 |= STAIN:ペニス
        STAIN:ペニス |= STAIN:PLAYER:足
    ;PLAYERの指⇔TARGETのＶの汚れが移動
    ELSE
        STAIN:PLAYER:ヴァギナ |= STAIN:ペニス
        STAIN:ペニス |= STAIN:PLAYER:ヴァギナ
    ENDIF

