;-------------------------------------------------
;二本フェラ実行判定
;-------------------------------------------------
@COMABLE_[[TRAIN:二本フェラ]]
#FUNCTION
    ;二本フェラ実行判定
    RESULT = COMABLE_DEF(TNUM("二本フェラ")) && COND("口の使用", PLAYER)
    RETURNF RESULT


;-------------------------------------------------
;調教時メッセージ
;-------------------------------------------------
@TRAIN_MESSAGE_COM_[[TRAIN:二本フェラ]]
	PRINTFORML %CALLNAME:PLAYER%に%CALLNAME:TARGET%と%CALLNAME:(TARGET:1)%のペニスに同時に奉仕させた…

;-------------------------------------------------
;ソースの計算
;ARG:100％倍率
;-------------------------------------------------
@CALC_SOURCE_COM_[[TRAIN:二本フェラ]](ARG=100)
    ;-------------------------------------------------
    ;二本フェラをされた対象
    ;-------------------------------------------------
    ;快Ｃのソース
    ;ABL:技巧をみる
    TMP_SRC:TARGET:快Ｃ += 1200 + MIN(ABL:PLAYER:技巧, 5) * 500 + LIMIT(ABL:PLAYER:技巧 - 1,0,4) * 100 + LIMIT(ABL:PLAYER:技巧 - 2,0,3) * 100
    TMP_SRC:TARGET:露出 = 220
    TMP_SRC:TARGET:逸脱 = 50

    TMP_SRC:(TARGET:1):快Ｃ += 1200 + MIN(ABL:PLAYER:技巧, 5) * 500 + LIMIT(ABL:PLAYER:技巧 - 1,0,4) * 100 + LIMIT(ABL:PLAYER:技巧 - 2,0,3) * 100
    TMP_SRC:(TARGET:1):露出 = 220
    TMP_SRC:(TARGET:1):逸脱 = 50

    ;調教者のTALENT:舌使いをみる
    IF TALENT:PLAYER:舌使い
        TIMES TMP_SRC:TARGET:快Ｃ , 2.00
        TMP_SRC:TARGET:恭順 += TMP_SRC:TARGET:快Ｃ/20
        TIMES TMP_SRC:(TARGET:1):快Ｃ , 2.00
        TMP_SRC:(TARGET:1):恭順 += TMP_SRC:(TARGET:1):快Ｃ/20
    ENDIF

    IF PLAYER == MASTER
        TEMP_NUM = PLAYER
        ;ABL:従順をみる
        TMP_SRC:TARGET:快Ｃ = TMP_SRC:TARGET:快Ｃ * (MIN(ABL:TARGET:信頼, 5)*10 + 80) / 100
        TMP_SRC:(TARGET:1):快Ｃ = TMP_SRC:(TARGET:1):快Ｃ * (MIN(ABL:(TARGET:1):信頼, 5)*10 + 80) / 100

        ; ;ABL:奉仕精神をみる
        ; TMP_SRC:TARGET:快Ｃ = TMP_SRC:TARGET:快Ｃ * (MIN(ABL:TARGET:奉仕精神, 6)*30 + 50) / 100

        ;ABL:精液中毒をみる
        TMP_SRC:TARGET:快Ｃ = TMP_SRC:TARGET:快Ｃ * (MIN(ABL:MASTER:精液中毒, 5)*10 + 80) / 100
        TMP_SRC:(TARGET:1):快Ｃ = TMP_SRC:(TARGET:1):快Ｃ * (MIN(ABL:MASTER:精液中毒, 5)*10 + 80) / 100
        TMP_SRC:TARGET:快Ｃ = TMP_SRC:TARGET:快Ｃ * (MIN(ABL:TARGET:射精中毒, 5)*10 + 80) / 100
        TMP_SRC:(TARGET:1):快Ｃ = TMP_SRC:(TARGET:1):快Ｃ * (MIN(ABL:(TARGET:1):射精中毒, 5)*10 + 80) / 100
    ELSEIF TARGET == MASTER || (TARGET:1) == MASTER
        TEMP_NUM = TARGET
        SIF TARGET == MASTER
            TEMP_NUM = (TARGET:1)
        ;ABL:従順をみる
        TMP_SRC:MASTER:快Ｃ = TMP_SRC:MASTER:快Ｃ * (MIN(ABL:PLAYER:信頼, 5)*10 + 80) / 100

        ;ABL:奉仕精神をみる
        TMP_SRC:MASTER:快Ｃ = TMP_SRC:MASTER:快Ｃ * (MIN(ABL:PLAYER:奉仕精神, 6)*30 + 50) / 100

        ;ABL:精液中毒をみる
        TMP_SRC:MASTER:快Ｃ = TMP_SRC:MASTER:快Ｃ * (MIN(ABL:PLAYER:精液中毒, 5)*10 + 80) / 100
        TMP_SRC:MASTER:快Ｃ = TMP_SRC:MASTER:快Ｃ * (MIN(ABL:MASTER:射精中毒, 5)*10 + 80) / 100
        ;TEMP_NUMからPLAYERへの相性を見る
        SELECTCASE RELATION:TEMP_NUM:(NO:PLAYER)
            CASE IS < 50
                TIMES TMP_SRC:TEMP_NUM:快Ｃ , 0.5
            CASE IS < 90
                TIMES TMP_SRC:TEMP_NUM:快Ｃ , 0.75
            CASE IS < 110
                TIMES TMP_SRC:TEMP_NUM:快Ｃ , 1
            CASE IS < 150
                TIMES TMP_SRC:TEMP_NUM:快Ｃ , 1.25
            CASE IS < 200
                TIMES TMP_SRC:TEMP_NUM:快Ｃ , 1.5
            CASE IS < 300
                TIMES TMP_SRC:TEMP_NUM:快Ｃ , 1.75
            CASEELSE
                TIMES TMP_SRC:TEMP_NUM:快Ｃ , 2
        ENDSELECT
    ELSE
        ;TARGETからPLAYERへの相性を見る
        SELECTCASE RELATION:(NO:PLAYER)
            CASE IS < 50
                TIMES TMP_SRC:TARGET:快Ｃ , 0.5
            CASE IS < 90
                TIMES TMP_SRC:TARGET:快Ｃ , 0.75
            CASE IS < 110
                TIMES TMP_SRC:TARGET:快Ｃ , 1
            CASE IS < 150
                TIMES TMP_SRC:TARGET:快Ｃ , 1.25
            CASE IS < 200
                TIMES TMP_SRC:TARGET:快Ｃ , 1.5
            CASE IS < 300
                TIMES TMP_SRC:TARGET:快Ｃ , 1.75
            CASEELSE
                TIMES TMP_SRC:TARGET:快Ｃ , 2
        ENDSELECT
        ;(TARGET:1)からPLAYERへの相性を見る
        SELECTCASE RELATION:(TARGET:1):(NO:PLAYER)
            CASE IS < 50
                TIMES TMP_SRC:(TARGET:1):快Ｃ , 0.5
            CASE IS < 90
                TIMES TMP_SRC:(TARGET:1):快Ｃ , 0.75
            CASE IS < 110
                TIMES TMP_SRC:(TARGET:1):快Ｃ , 1
            CASE IS < 150
                TIMES TMP_SRC:(TARGET:1):快Ｃ , 1.25
            CASE IS < 200
                TIMES TMP_SRC:(TARGET:1):快Ｃ , 1.5
            CASE IS < 300
                TIMES TMP_SRC:(TARGET:1):快Ｃ , 1.75
            CASEELSE
                TIMES TMP_SRC:(TARGET:1):快Ｃ , 2
        ENDSELECT
     ENDIF

    ;奉仕者
    TMP_SRC:PLAYER:屈従 += 6000
    TMP_SRC:PLAYER:逸脱 += 600

    ;ABL:奉仕精神をみる
    TMP_SRC:PLAYER:性行動 += 800 + MIN(ABL:PLAYER:奉仕精神, 5) * 250
    TMP_SRC:PLAYER:達成 += 600 + MIN(ABL:PLAYER:奉仕精神, 5) * 300
    TMP_SRC:PLAYER:不潔 += 100 + COM_汚れ(TARGET,STNNUM("ペニス"),STNNUM("口"),1,1) * 40
    TMP_SRC:PLAYER:不潔 += 100 + COM_汚れ((TARGET:1),STNNUM("ペニス"),STNNUM("口"),1,1) * 40

    ;ABL:技巧をみる
    SELECTCASE ABL:PLAYER:技巧
        CASE 0
            TIMES TMP_SRC:PLAYER:性行動 , 0.5
            TIMES TMP_SRC:PLAYER:達成 , 0.5
        CASE 1
            TIMES TMP_SRC:PLAYER:性行動 , 0.8
            TIMES TMP_SRC:PLAYER:達成 , 0.8
        CASE 2
            TIMES TMP_SRC:PLAYER:性行動 , 1
            TIMES TMP_SRC:PLAYER:達成 , 1
        CASE 3
            TIMES TMP_SRC:PLAYER:性行動 , 1.2
            TIMES TMP_SRC:PLAYER:達成 , 1.2
        CASE 4
            TIMES TMP_SRC:PLAYER:性行動 , 1.5
            TIMES TMP_SRC:PLAYER:達成 , 1.5
        CASEELSE
            TIMES TMP_SRC:PLAYER:性行動 , 2
            TIMES TMP_SRC:PLAYER:達成 , 2
    ENDSELECT

    ;ABL:奉仕精神をみる
    SELECTCASE ABL:PLAYER:奉仕精神
        CASE 0
            TIMES TMP_SRC:PLAYER:不潔 , 4.00
        CASE 1
            TIMES TMP_SRC:PLAYER:不潔 , 2.5
        CASE 2
            TIMES TMP_SRC:PLAYER:不潔 , 1.5
        CASE 3
            TIMES TMP_SRC:PLAYER:不潔 , 1
        CASE 4
            TIMES TMP_SRC:PLAYER:不潔 , 0.5
        CASEELSE
            TIMES TMP_SRC:PLAYER:不潔 , 0.1
    ENDSELECT
    
	CALL APPLY_SOURCE_RATE(ARG)

;-------------------------------------------------
;経験上昇
;ARG:100％倍率
;-------------------------------------------------
@CALC_NOWEX_COM_[[TRAIN:二本フェラ]](ARG=100)
    NOWEX:TARGET:体力変動 += 5
    NOWEX:TARGET:気力変動 += 5
    NOWEX:(TARGET:1):体力変動 += 5
    NOWEX:(TARGET:1):気力変動 += 5
    NOWEX:PLAYER:体力変動 += 80
    NOWEX:PLAYER:気力変動 += 80
    SIF !TALENT:PLAYER:精愛味覚
        NOWEX:PLAYER:気力変動 *= 10

    NOWEX:PLAYER:フェラ経験 += 2

    ;レズ経験・ホモ経験
    IF HAVE_VAGINA(TARGET) && HAVE_VAGINA(PLAYER) 
        NOWEX:レズ経験 = 5
        NOWEX:PLAYER:レズ経験 = 5
    ELSEIF IS_MALE(TARGET) && IS_MALE(PLAYER) 
        NOWEX:ＢＬ経験 = 5
        NOWEX:PLAYER:ＢＬ経験 = 5
    ENDIF

    IF HAVE_VAGINA((TARGET:1)) && HAVE_VAGINA(PLAYER) 
        NOWEX:(TARGET:1):レズ経験 = 5
        NOWEX:PLAYER:レズ経験 = 5
    ELSEIF IS_MALE((TARGET:1)) && IS_MALE(PLAYER) 
        NOWEX:(TARGET:1):ＢＬ経験 = 5
        NOWEX:PLAYER:ＢＬ経験 = 5
    ENDIF

    IF PLAYER == MASTER
        SIF CFLAG:好感度 >= 1000
            NOWEX:愛情経験 += 2
        SIF CFLAG:(TARGET:1):好感度 >= 1000
            NOWEX:(TARGET:1):愛情経験 += 2
    ELSEIF CFLAG:PLAYER:好感度 >= 1000 && (TARGET == MASTER || (TARGET:1) == MASTER)
        NOWEX:PLAYER:愛情経験 += 2
    ENDIF
    
	CALL APPLY_EX_RATE(ARG)

;-------------------------------------------------
;FLAGの計算
;-------------------------------------------------
@CALC_FLAG_COM_[[TRAIN:二本フェラ]]
    IF PLAYER == MASTER
        TCVAR:主人経験 += 1
        TCVAR:(TARGET:1):主人経験 += 1
    ENDIF
    IF TARGET == MASTER || (TARGET:1) == MASTER
        TCVAR:PLAYER:主人経験 += 1
        ;屈服刻印３に相当
        TCVAR:PLAYER:屈服刻印取得 = 2
    ENDIF

    TCVAR:快楽経験 = 1
    TCVAR:(TARGET:1):快楽経験 = 1
    TCVAR:PLAYER:奉仕経験 = 1
    ;-------------------------------------------------
    ;汚れの処理
    ;-------------------------------------------------
    ;奴隷のＰ⇔調教者の口の汚れが移動
    STAIN:PLAYER:口 |= STAIN:ペニス
	STAIN:PLAYER:口 |= STAIN:(TARGET:1):ペニス
    STAIN:ペニス |= STAIN:PLAYER:口
    STAIN:(TARGET:1):ペニス |= STAIN:PLAYER:口
