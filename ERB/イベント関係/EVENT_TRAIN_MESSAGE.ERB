			PRINTFORML %CALLNAME:TARGET%は愛液が飛び散るのもお構いなしに、スライムによって開かれた膣内に指を激しく出し入れしている
			PRINTFORML どうやらもうほかの事を気にする余裕も無いようだ…
		ELSEIF TEQUIP:スライム肛門進入 && ABL:Ａ感覚 >= 5 && ABL:Ｃ感覚 >= 5 && ABL:Ｂ感覚 >= 5 && PALAM:欲情 >= PALAMLV:4 && PREVCOM == TNUM("オナニー")
			PRINTFORML %CALLNAME:TARGET%はガクガク身体を震わせながら、スライムによって開かれたアヌスに指を突きこんでいる
			PRINTFORML どうやら襞をえぐるたびに何度も絶頂してしまっているようだ…
		ELSEIF ABL:信頼 >= 3 && ABL:Ｃ感覚 >= 5 && ABL:Ｂ感覚 >= 5 && PALAM:欲情 >= PALAMLV:4 && PREVCOM == TNUM("スライムオナニー")
			PRINTFORML %CALLNAME:TARGET%は嬌声をあげながら纏わり付くスライムを気にすること無く一心不乱に自らの%SAVESTR:2%続けている
			PRINTFORML どうやら止めたくても手が勝手に動いて止まらないようだ…
		ENDIF

		
		
	;--------------------------------------------------------
	;スライム口辱
	;--------------------------------------------------------
	ELSEIF SELECTCOM == TNUM("スライム口辱")
		IF TEQUIP:スライム口辱
			PRINTFORML スライムは%CALLNAME:TARGET%の口を解放した…
		ELSE
			PRINTFORM スライムは
			IF CFLAG:特別コスタイプ == 11 && (CFLAG:着衣状態 & 64)
				CALL PRINT_CLOTHTYPE_SPECIAL
				PRINTFORM の隙間を通って潜り込み、
			ENDIF
			PRINTFORML %CALLNAME:TARGET%の口に侵入した…
		ENDIF
	;--------------------------------------------------------
	;手コキフェラ
	;--------------------------------------------------------
	ELSEIF SELECTCOM == TNUM("アナル舐め手コキ")
		PRINTFORM %CALLNAME:TARGET%は
		SIF TALENT:マゾ
			PRINT うっとりとした表情をして
		PRINTFORM 四つん這いになった%CALLNAME:PLAYER%のペニスを扱きながら、%CALLNAME:PLAYER%の
		IF ABL:PLAYER:Ａ感覚 >= 3
			PRINTFORM 快楽にヒクつく
		ELSE
			PRINTFORM 固く閉ざされた
		ENDIF
		PRINTL 薄桃色のすぼまりの中に尖らせた舌先を挿入した…
		IF (CFLAG:ピアス状況 & 16)
			PRINTFORM %CALLNAME:TARGET%の舌先に取り付けられたピアスが%CALLNAME:PLAYER%の
			IF IS_MALE(PLAYER) 
				PRINTFORM 前立腺
			ELSE
				PRINTFORM 腸壁
			ENDIF
			PRINTFORM に触れるたび、%CALLNAME:PLAYER%は思わず快楽の声を漏らし
			IF ASSIPLAY
				PRINTFORM て
			ELSE
				PRINTFORM た
			ENDIF
			PRINTFORML …
		ENDIF
	;--------------------------------------------------------
	;具現
	;--------------------------------------------------------
	ELSEIF SELECTCOM == TNUM("具現")
		IF !IS_FUTA(TARGET)
			PRINTFORM %CALLNAME:PLAYER%に命じられた%CALLNAME:TARGET%は
			PRINTFORM 自身の陰核の位置に%CALLNAME:TARGET%のような
			SIF MAXBASE:魅力値 >= 120
				PRINTFORM 美
			IF CFLAG:実年齢 <= 19
				PRINTFORM 少女
			ELSE
				PRINTFORM 女
			ENDIF
			PRINTFORML には不釣合いな、射精機能を伴った肉茎を具現化させた…
			IF PALAM:快Ｃ > PALAMLV:3
				PRINTFORML クリトリスと感覚が繋がっているらしい具現化したペニスは既に血管が浮き出るほど張り詰めており、
				PRINTFORML %CALLNAME:TARGET%の昂ぶりを示すかのように亀頭がぬるぬるとしたカウパーで照り光っている
			ENDIF
		ELSE
			PRINTFORM %CALLNAME:PLAYER%に命じられた%CALLNAME:TARGET%は
			PRINTFORML 具現化させたペニスを消去した…
			IF ABL:射精中毒 >= 3
				PRINTFORM すっかりと擬似的とはいえ射精の快楽を覚えてしまった
				PRINTFORML %CALLNAME:TARGET%は、喪失感からか無意識のうちにペニスの生えていた位置をまさぐっている
			ENDIF
		ENDIF
	ENDIF

							;****スライムパッチ追加ここまで****
	;-------------------------------------------------
	;ソースの計算(確定値)
	;-------------------------------------------------
	SELECTCASE SELECTCOM
		; ;例外コマンド
		; CASE TNUM("バイブ"), TNUM("アナルバイブ"), TNUM("ピアッシング"), TNUM("尿道ブジー"), TNUM("尿道バイブ")
		CASEELSE
			VARSET LOSEBASE_CHAR:ARG:体力
			TRYCALLFORM CALC_SOURCE_COM_%SELECTCOM%(100, ARG, ARG:1)
	ENDSELECT
	;-------------------------------------------------
	;SOURCE計算
	;-------------------------------------------------
	CALL CALC_SOURCE, "調教コマンド"

	RETURN 1
