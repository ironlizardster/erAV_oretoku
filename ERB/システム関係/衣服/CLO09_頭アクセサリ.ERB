;-------------------------------------------------
;キャラARGに頭アクセサリARGSをつける。ARGS == "" なら全部外す
;これだけは / で区切って10個程度まで装備可能
;他のものと異なり各装備に追加の属性などは無く、記号的な意味が非常に強い
;既に着けている頭アクセサリに区分が被った物がある場合には上書きする
;-------------------------------------------------
@SET_HEADACC, ARGS, ARG
#DIM LCOUNT
#DIMS MEMO_CLO

	MEMO_CLO = %CSTR:ARG:頭アクセサリ%

	SELECTCASE ARGS
		CASE ""
			CSTR:ARG:頭アクセサリ = 
		CASEELSE
			VARSET LOCALS
			SPLIT ARGS, "/", LOCALS

			;すでに装備している物から区分被りを消す
			FOR LCOUNT, 0, 10
				SELECTCASE LOCALS:LCOUNT
				CASE ""
					CONTINUE
				CASEELSE
					CALL RESET_HEADACC, LOCALS:LCOUNT, ARG
				ENDSELECT
			NEXT
			CSTR:ARG:頭アクセサリ += @"%ARGS%\/"
			;念のため "/" の整理
			CALL RESET_HEADACC, "", ARG
	ENDSELECT

	EQUIP:ARG:頭アクセサリ = STRLENS(CSTR:ARG:頭アクセサリ)
	SIF MEMO_CLO != CSTR:ARG:頭アクセサリ
		TFLAG:着替えた = 1
	RETURN 1


;-------------------------------------------------
;ARGが身に着けているARGSをはずし、順番を区分依存で揃える
;身に着けていない場合は何も起きない…のでARGSに""を入れる事で不要な "/" の整理も出来る
;-------------------------------------------------
@RESET_HEADACC, ARGS, ARG
#DIM LCOUNT
#DIMS ORDER_HEADACC, 10

	VARSET LOCALS
	SPLIT CSTR:ARG:頭アクセサリ, "/", LOCALS
	CSTR:ARG:頭アクセサリ = 

	VARSET ORDER_HEADACC
	FOR LCOUNT, 0, 10

		SELECTCASE LOCALS:LCOUNT
		;ARGSと一致する場合は飛ばす
		CASE "", ARGS
			CONTINUE
		;ARGSが"その他"以外の区分ならばARGSと同じ区分のものを飛ばす
		CASEELSE
			SIF TYPE_HEADACC(ARGS) != "" && TYPE_HEADACC(LOCALS:LCOUNT) == TYPE_HEADACC(ARGS)
				CONTINUE
		ENDSELECT

		SELECTCASE TYPE_HEADACC(LOCALS:LCOUNT)
			CASE "首"
				ORDER_HEADACC:0 += @"%LOCALS:LCOUNT%\/"
			CASE "眼鏡"
				ORDER_HEADACC:1 += @"%LOCALS:LCOUNT%\/"
			CASE "帽子"
				ORDER_HEADACC:2 += @"%LOCALS:LCOUNT%\/"
			CASE "つけ耳"
				ORDER_HEADACC:3 += @"%LOCALS:LCOUNT%\/"
			CASE "髪飾り"
				ORDER_HEADACC:4 += @"%LOCALS:LCOUNT%\/"
			CASE "外套"
				ORDER_HEADACC:5 += @"%LOCALS:LCOUNT%\/"
			CASEELSE
				SIF LOCALS:LCOUNT != ""
					ORDER_HEADACC:6 += @"%LOCALS:LCOUNT%\/"
		ENDSELECT
	NEXT

	FOR LCOUNT, 0, 10
		SELECTCASE ORDER_HEADACC:LCOUNT
			CASE ""
				CONTINUE
			CASEELSE
				CSTR:ARG:頭アクセサリ += @"%ORDER_HEADACC:LCOUNT%"
		ENDSELECT
	NEXT

	EQUIP:ARG:頭アクセサリ = STRLENS(CSTR:ARG:頭アクセサリ)

;-------------------------------------------------
;CSTR:ARG:頭アクセサリにARGSと完全一致するものがある場合には外し、そうでないなら装備させる
;-------------------------------------------------
@INVERTSET_HEADACC, ARGS, ARG

	IF STRCOUNT(@"\/%CSTR:ARG:頭アクセサリ%", @"\/%ARGS%\/")
		CALL RESET_HEADACC, ARGS, ARG
	ELSE
		CALL SET_HEADACC, ARGS, ARG
	ENDIF

;-------------------------------------------------
;頭アクセサリARGSの区分を返す。その他など特定区分に属さないものの場合は空文字が返る
;-------------------------------------------------
@TYPE_HEADACC(ARGS)
#FUNCTIONS
#DIMS CHECK_TABLE
#DIM LCOUNT

	CHECK_TABLE = 首/眼鏡/帽子/つけ耳/髪飾り/外套
	VARSET LOCALS
	SPLIT CHECK_TABLE, "/", LOCALS

	FOR LCOUNT, 0, 10
		SIF LOCALS:LCOUNT == ""
			BREAK
		SELECTCASE LOCALS:LCOUNT
			CASE ""
				BREAK
			CASE "首"
				SIF STRCOUNTS(ARGS, "首", "ペンダント", "ネックレス", "タイ", "チョーカー", "マフラー", "ストール")
					RETURNF LOCALS:LCOUNT
			CASE "眼鏡"
				SIF STRCOUNTS(ARGS, "眼鏡", "モノクル", "グラス", "目隠し")
					RETURNF LOCALS:LCOUNT
			CASE "帽子"
				SIF STRCOUNTS(ARGS, "ハット", "帽", "ヘッドドレス", "ボンネット", "キャップ", "ベール")
					RETURNF LOCALS:LCOUNT
			CASE "つけ耳"
				SIF STRCOUNT(ARGS, "耳")
					RETURNF LOCALS:LCOUNT
			CASE "髪飾り"
				SIF STRCOUNTS(ARGS, "カチューシャ", "リボン", "サークレット", "ティアラ", "かんざし", "髪", "ヘアピン")
					RETURNF LOCALS:LCOUNT
			CASE "外套"
				SIF STRCOUNTS(ARGS, "外套", "マント", "コート", "ジャケット", "ジャンバー", "パーカー", "どてら", "羽織", "ケープ", "ジャージ", "カーディガン", "エプロン", "サスペンダー")
					RETURNF LOCALS:LCOUNT
		ENDSELECT
	NEXT
	RETURNF ""

;-------------------------------------------------
;キャラARGが身に着ける頭アクセサリ内の、ARGS区分の頭アクセサリの名前。基本的に一つしか身に着けないものが対象
;ARGS区分のものを身に着けているか否かの判定にも使える。
;-------------------------------------------------
@HEADACC(ARG, ARGS)
#FUNCTIONS
#DIM LCOUNT

	VARSET LOCALS
	SPLIT CSTR:ARG:頭アクセサリ, "/", LOCALS

	FOR LCOUNT, 0, 10
		SELECTCASE LOCALS:LCOUNT
			CASE ""
				BREAK
			CASEELSE
				SIF TYPE_HEADACC(LOCALS:LCOUNT) == ARGS
					RETURNF LOCALS:LCOUNT
		ENDSELECT
	NEXT
	RETURNF ""

;-------------------------------------------------
;ARG番の頭アクセサリの名称。着せ替えなどで表を作る際に使う
;-------------------------------------------------
@NAME_HEADACC(ARG)
#FUNCTIONS
	VARSET RESULTS
	SELECTCASE ARG
		CASE 52
			RESULTS = ナースキャップ
		CASE 54
			RESULTS = ヘアリボン
		CASE 60
			RESULTS = シスターヴェール
		CASE 61
			RESULTS = ウェディングベール
		CASE 63
			RESULTS = 聖ウルスラ高校帽子
		CASE 64
			RESULTS = 麻帆良芸大付属中の帽子
		CASE 65
			RESULTS = 猫耳
		CASE 71
			RESULTS = 首輪
		CASE 73
			RESULTS = カウベルと鼻輪
		CASE 80
			RESULTS = 眼鏡
		CASE 81
			RESULTS = サングラス
		CASE 99
			RESULTS = ガラスのねこみみ
	ENDSELECT

	RETURNF RESULTS

;-------------------------------------------------
;ARGの身につけている小物が条件ARGSを満たすか確認する
;-------------------------------------------------
@CHECK_HEADACC(ARGS, ARG)
#FUNCTION

	SIF EQUIP:ARG:頭アクセサリ == 0
		RETURNF 0

	SELECTCASE ARGS
		CASE "首", "眼鏡", "帽子", "つけ耳", "髪飾り", "外套"
			SIF HEADACC(ARG, ARGS) != ""
				RETURNF 1
		CASE "髪飾りリボン"
			SIF STRCOUNTS(@"\/%CSTR:ARG:頭アクセサリ%", "/リボン/", "/両側リボン/", "/片側リボン/", "/後ろリボン/", "/頭上リボン/")
				RETURNF 1
		CASEELSE
			SIF STRCOUNT(CSTR:ARG:頭アクセサリ, ARGS)
				RETURNF 1
	ENDSELECT
	RETURNF 0

