;-------------------------------------------------
;キャラARGに下服ARGSを着せた場合のCSTR処理
;-------------------------------------------------
@PALAM_LOWER, ARGS, ARG
;追加で記述された属性を一時的に保管する
#DIMS STR_ADD

	STR_ADD = %EXTSTR(ARGS, "/")%
	ARGS = %EXTSTR(ARGS, "", "/")%

	SELECTCASE ARGS
		CASE "", "無し"
			CSTR:ARG:下服 = 
		CASE "ブルマ"
			CSTR:ARG:下服 = ブルマ/%CLOCOLOR_MAIDFACE("ブルマ", "", ARG)%/
		;CASE "ハイレグブルマ"
		;	CSTR:ARG:下服 = ハイレグブルマ/%CLOCOLOR_MAIDFACE("ブルマ", "", ARG)%/Ｔバック/
		CASE "スパッツ"
			CSTR:ARG:下服 = スパッツ/ずれ不可/%CLOCOLOR_MAIDFACE("スパッツ", "", ARG)%/
		CASE "ホットパンツ", "ショートパンツ"
			CSTR:ARG:下服 = %ARGS%/ずれ不可/コキ不可/隙間チラ可/ズボン/社会の窓/%CLOCOLOR_MAIDFACE("ホットパンツ", "", ARG)%/
		CASE "前開きホットパンツ", "前開きショートパンツ"
			CSTR:ARG:下服 = %ARGS%/ずれ不可/コキ不可/隙間チラ可/ズボン/社会の窓/%CLOCOLOR_MAIDFACE("ホットパンツ", "", ARG)%/
		CASE "ダメージホットパンツ", "ダメージショートパンツ"
			CSTR:ARG:下服 = %ARGS%/ずれ不可/コキ不可/隙間チラ可/ズボン/社会の窓/%CLOCOLOR_MAIDFACE("ホットパンツ", "", ARG)%/
		CASE "ミニホットパンツ", "ミニショートパンツ"
			CSTR:ARG:下服 = %ARGS%/ずれ不可/コキ不可/隙間チラ可/ローライズ/ズボン/社会の窓/%CLOCOLOR_MAIDFACE("ホットパンツ", "", ARG)%/
		CASE "ロングパンツ"
			CSTR:ARG:下服 = ロングパンツ/ずれ不可/コキ不可/ズボン/ロングパンツ/%CLOCOLOR_MAIDFACE("ロングパンツ", "", ARG)%/
		CASE "前開きロングパンツ"
			CSTR:ARG:下服 = 前開きロングパンツ/ずれ不可/コキ不可/ズボン/ロングパンツ/%CLOCOLOR_MAIDFACE("ロングパンツ", "", ARG)%/

		CASE "ハーフパンツ"
			CSTR:ARG:下服 = ハーフパンツ/ずれ不可/コキ不可/隙間チラ可/ズボン/男物可/
		CASE "ジャージズボン"
			CSTR:ARG:下服 = ジャージズボン/ずれ不可/コキ不可/ズボン/男物可/
		CASE "ジーンズ"
			CSTR:ARG:下服 = ジーンズ/ずれ不可/コキ不可/ズボン/男物可/社会の窓/ロングパンツ/%CLOCOLOR_MAIDFACE("ジーンズ", "", ARG)%/
		CASE "前開きジーンズ"
			CSTR:ARG:下服 = 前開きジーンズ/ずれ不可/コキ不可/ズボン/男物可/社会の窓/ロングパンツ/%CLOCOLOR_MAIDFACE("ジーンズ", "", ARG)%/
		CASE "ローライズジーンズ"
			CSTR:ARG:下服 = ローライズジーンズ/ずれ不可/コキ不可/ズボン/社会の窓/ロングパンツ/%CLOCOLOR_MAIDFACE("ジーンズ", "", ARG)%/
		CASE "レギンス"
			CSTR:ARG:下服 = レギンス/ずれ不可/コキ不可/ズボン/
		CASE "スキニーパンツ"
			CSTR:ARG:下服 = スキニーパンツ/ずれ不可/コキ不可/ズボン/ロングパンツ/%CLOCOLOR_MAIDFACE("ロングパンツ", "", ARG)%/

		CASE "パンスト"
			CSTR:ARG:下服 = パンスト/ずれ不可/コキ不可/シースルー/%CLOCOLOR_MAIDFACE("パンスト", "", ARG)%/
		CASE "網パンスト"
			CSTR:ARG:下服 = 網パンスト/ずれ不可/コキ不可/レース/黒/
		CASE "オープンパンスト"
			CSTR:ARG:下服 = オープンパンスト/ずれ不可/コキ不可/Ｖ露出/Ａ露出/
		CASE "パンスト黒", "黒いパンスト"
			CSTR:ARG:下服 = パンスト/ずれ不可/コキ不可/シースルー/黒/
		CASE "パンスト赤"
			CSTR:ARG:下服 = パンスト/ずれ不可/コキ不可/シースルー/赤/
		CASE "パンスト白"
			CSTR:ARG:下服 = パンスト/ずれ不可/コキ不可/シースルー/白/

		CASE "タイツ"
			CSTR:ARG:下服 = タイツ/ずれ不可/コキ不可/%CLOCOLOR_MAIDFACE("タイツ", "", ARG)%/
		CASE "オープンタイツ"
			CSTR:ARG:下服 = オープンタイツ/ずれ不可/コキ不可/Ｖ露出/Ａ露出/%CLOCOLOR_MAIDFACE("タイツ", "", ARG)%/
		CASE "網タイツ"
			CSTR:ARG:下服 = 網タイツ/ずれ不可/コキ不可/黒/
		CASE "オープン網タイツ"
			CSTR:ARG:下服 = オープン網タイツ/ずれ不可/コキ不可/Ｖ露出/Ａ露出/黒/

		CASE "オーバーオール"
			CSTR:ARG:下服 = オーバーオール/ずれ不可/コキ不可/ズボン/男物可/社会の窓/スカート不可/

		CASE "ズボン"
			CSTR:ARG:下服 = ズボン/ずれ不可/コキ不可/ズボン/男物可/社会の窓/ロングパンツ/%CLOCOLOR_MAIDFACE("ロングパンツ", "", ARG)%/
		CASE "前開きズボン"
			CSTR:ARG:下服 = 前開きズボン/ずれ不可/コキ不可/ズボン/男物可/社会の窓/ロングパンツ/%CLOCOLOR_MAIDFACE("ロングパンツ", "", ARG)%/
		CASE "スラックス"
			CSTR:ARG:下服 = スラックス/ずれ不可/コキ不可/ズボン/男物可/社会の窓/ロングパンツ/%CLOCOLOR_MAIDFACE("ロングパンツ", "", ARG)%/
		CASE "キュロットスカート"
			CSTR:ARG:下服 = キュロットスカート/ずれ不可/コキ不可/隙間チラ可/ズボン/
		CASE "馬上袴"
			CSTR:ARG:下服 = 馬上袴/ずれ不可/コキ不可/ズボン/男物可/スカート不可/
		CASE "巫女服"
			CSTR:ARG:下服 = 巫女服/ズボンセット/ずれ不可/コキ不可/ズボン/男物可/スカート不可/
		CASE "サンタズボン"
			CSTR:ARG:下服 = サンタズボン/ずれ不可/コキ不可/ズボン/男物可/
		CASE "パニエ入りサーキュラスカート"
			CSTR:ARG:下服 = パニエ入りサーキュラスカート/フリル/
		CASE "花柄パレオ"
			CSTR:ARG:下服 = 花柄パレオ/水着/花柄/
		CASE "パレオ"
			CSTR:ARG:下服 = パレオ/水着/
		CASE "タイトスカート", "ロングタイトスカート", "ミニタイトスカート", "マイクロタイトスカート"
			CSTR:ARG:下服 = %ARGS%/シャツイン/
		CASEELSE
			CSTR:ARG:下服 = %ARGS%/
	ENDSELECT

	CSTR:ARG:下服 = %MERGE_STR(CSTR:ARG:下服, STR_ADD)%


;-------------------------------------------------
;ARGの下服が条件ARGSを満たすか確認する
;-------------------------------------------------
@CHECK_LOWER(ARGS, ARG)
#FUNCTION
	SIF EQUIP:ARG:下服 == 0
		RETURNF 0

	SELECTCASE ARGS
		CASE "シャツ"
			SIF STRCOUNT(CSTR:ARG:下服, "シャツ") && STRCOUNT(CSTR:ARG:下服, "シャツイン") == 0
				RETURNF 1
		CASE "超ミニ"
			SIF STRCOUNTS(CSTR:ARG:下服, "超ミニ", "マイクロ")
				RETURNF 1
		CASE "ミニ"
			SIF STRCOUNTS(CSTR:ARG:下服, "ミニ", "マイクロ")
				RETURNF 1
		CASE "スカート"
			SIF STRCOUNTS(CSTR:ARG:下服, "スカート", "ワンピース")
				RETURNF 1
		CASE "前開き可"
			;既に開かれている
			SIF STRCOUNT(CSTR:ARG:下服, "前開き")
				RETURNF 0
			SIF STRCOUNTS(CSTR:ARG:下服, "ホットパンツ", "ロングパンツ")
				RETURNF 1
		CASE "パンスト"
			;タイツもOK
			SIF STRCOUNTS(CSTR:ARG:下服, "パンスト", "タイツ") == 0
				RETURNF 0
			RETURNF 1
		;主に埴輪ルックの判定で使う
		CASE "丈長ズボン"
			;ズボンじゃないとダメ
			SIF STRCOUNTS(CSTR:ARG:下服, "ズボン", "ロングパンツ") == 0
				RETURNF 0
			;丈の短いもの
			SIF STRCOUNTS(CSTR:ARG:下服, "ホットパンツ", "ショート")
				RETURNF 0
			RETURNF 1
		CASE "股間の隙間"
			;太ももの付け根までを布地が締め付けている服
			SIF STRCOUNTS(CSTR:ARG:下服, "スパッツ", "ホットパンツ", "ショートパンツ")
				RETURNF 1
		;主に"アソコのチラ見せ撮影"の判定で使う
		CASE "めくり可能"
			;めくれなさそうなもの
			SIF STRCOUNTS(CSTR:ARG:下服, "パンスト", "ずれ不可")
				RETURNF 0
			RETURNF 1
		;ずれ不可でなく、ずらしていない
		CASE "ずらし可", "ずらせる"
			SIF STRCOUNT(CSTR:ARG:下服, "Ｖ露出")
				RETURNF 0
			IF STRCOUNT(CSTR:ARG:下服, "ファスナー")
				SIF STRCOUNT(CSTR:ARG:下服, "ファスナー開")
					RETURNF 0
				RETURNF 1
			ENDIF
			SIF STRCOUNTS(CSTR:ARG:下服, "ずらした", "ずれ不可")
				RETURNF 0
			RETURNF 1
		;パンストで、破いていない
		CASE "破ける"
			SIF STRCOUNT(CSTR:ARG:下服, "破いた")
				RETURNF 0
			SIF STRCOUNTS(CSTR:ARG:下服, "パンスト", "網タイツ")
				RETURNF 1
		;ファスナーがあり、あけていない
		CASE "ファスナー閉"
			SIF STRCOUNT(CSTR:ARG:下服, "ファスナー開")
				RETURNF 0
			SIF STRCOUNT(CSTR:ARG:下服, "ファスナー")
				RETURNF 1
		CASE "ＶＡ露出"
			SIF STRCOUNT(CSTR:ARG:下服, "Ｖ露出") && STRCOUNT(CSTR:ARG:下服, "Ａ露出")
				RETURNF 1
			SIF STRCOUNT(CSTR:ARG:下服, "オープン")
				RETURNF 1
		CASE "クロッチ"
			SIF STRCOUNTS(CSTR:ARG:下服, "ファスナー開", "ずらした", "破いた", "Ｖ露出", "スリット", "オープン")
				RETURNF 0
			RETURNF 1
		CASE "クロッチありパンスト"
			SIF STRCOUNTS(CSTR:ARG:下服, "ファスナー開", "ずらした", "破いた", "Ｖ露出", "スリット", "オープン")
				RETURNF 0
			SIF STRCOUNT(CSTR:ARG:下服, "パンスト")
				RETURNF 1
		CASE "Ａクロッチ"
			SIF STRCOUNTS(CSTR:ARG:下服, "ファスナー開", "ずらした", "破いた", "Ａ露出", "スリット", "オープン")
				RETURNF 0
			RETURNF 1
		CASE "食い込み"
			SIF STRCOUNTS(CSTR:ARG:下服, "ずらした", "ファスナー開", "Ｖ露出", "スリット", "破いた", "オープン")
				RETURNF 0
			SIF STRCOUNTS(CSTR:ARG:下服, "ハイレグ")
				RETURNF 1
		CASE "ローライズ"
			SIF STRCOUNTS(CSTR:ARG:下服, "ローライズ", "ローレグ")
				RETURNF 1
		CASE "蒸れ"
			SIF STRCOUNTS(CSTR:ARG:下服, "ずらした", "ファスナー開", "Ｖ露出", "スリット", "破いた", "オープン")
				RETURNF 0
			SIF CHECK_STAIN(STAIN:ARG:下服, "蒸れ")
				RETURNF 1
		CASE "染み"
			SIF STRCOUNTS(CSTR:ARG:下服, "ずらした", "ファスナー開", "Ｖ露出", "スリット", "破いた", "通気性無し", "オープン")
				RETURNF 0
			SIF CHECK_STAIN(STAIN:ARG:下服, "濡れ")
				RETURNF 1
		CASEELSE
			SIF STRCOUNT(CSTR:ARG:下服, ARGS)
				RETURNF 1
	ENDSELECT
