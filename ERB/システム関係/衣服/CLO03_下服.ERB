;-------------------------------------------------
;キャラARGにARGSを着せる。ARGS == ""なら脱がす
;-------------------------------------------------
@SET_LOWER, ARGS, ARG
#DIMS MEMO_CLO
	MEMO_CLO = %CSTR:ARG:下服%
	;汚れ＆ずれたりしたフラグ等を初期化して新品にする
	STAIN:ARG:下服 = 0

	CALL PALAM_LOWER, ARGS, ARG

	;コモンフラグを設定する
	CSTR:ARG:下服 = %SET_CLO_COMMON(CSTR:ARG:下服, ARG)%
	EQUIP:ARG:下服 = STRLENS(CSTR:ARG:下服)

	;セットじゃない場合に上服のセットを脱がす
	IF (CHECK_UPPER("ワンピース", ARG) || CHECK_LOWER("ズボンセット", ARG) || CHECK_UPPER("上下セット", ARG)) && CSTR:ARG:上服 != CSTR:ARG:下服
		CALL SET_UPPER, "", ARG

	SIF !TFLAG:着替えた && MEMO_CLO != CSTR:ARG:下服
		TFLAG:着替えた = 1

;-------------------------------------------------
;ARGの下服の名前。ARGSに"略"と入れると略称になる
;-------------------------------------------------
@LOWER(ARG, ARGS)
#FUNCTIONS
#DIM LCOUNT
#DIMS COLOR_ABOUT
	VARSET RESULTS
	SELECTCASE ARGS
		CASE "略"
			IF CHECK_LOWER("ブルマ", ARG)
				RESULTS = ブルマ
			ELSEIF CHECK_LOWER("ホットパンツ", ARG)
				RESULTS = ホットパンツ
			ELSEIF CHECK_LOWER("ショートパンツ", ARG)
				RESULTS = ショートパンツ
			ELSEIF CHECK_LOWER("スパッツ", ARG)
				RESULTS = スパッツ
			ELSEIF CHECK_LOWER("パジャマ", ARG)
				RESULTS = パジャマズボン
			ELSEIF CHECK_LOWER("ハーフパンツ", ARG)
				RESULTS = ハーフパンツ
			ELSEIF CHECK_LOWER("ショートパンツ", ARG)
				RESULTS = ショートパンツ
			ELSEIF CHECK_LOWER("ジャージ", ARG)
				RESULTS = ジャージ
			;ELSEIF CHECK_LOWER("ローライズジーンズ", ARG)
			;	RESULTS = ローライズジーンズ
			ELSEIF CHECK_LOWER("ジーンズ", ARG)
				RESULTS = ジーンズ
			ELSEIF CHECK_LOWER("キュロットスカート", ARG)
				RESULTS = キュロット
			ELSEIF CHECK_LOWER("馬上袴", ARG)
				RESULTS = 袴
			ELSEIF CHECK_UPPER("巫女服", ARG)
				RESULTS = 緋袴
			ELSEIF CHECK_LOWER("網タイツ", ARG) || CHECK_LOWER("網パンスト", ARG)
				RESULTS = "網タイツ"
			ELSEIF CHECK_LOWER("タイツ", ARG)
				RESULTS = "タイツ"
			ELSEIF CHECK_LOWER("パンスト", ARG)
				RESULTS = "パンスト"
			ELSEIF CHECK_LOWER("レギンス", ARG)
				RESULTS = レギンス
			ELSEIF EQUIP:ARG:下服
				RESULTS = ズボン
			ELSEIF CHECK_LOWER("鎧", ARG)
				RESULTS = 垂れ
			ELSEIF CHECK_LOWER("パレオ", ARG)
				RESULTS = パレオ
			ELSEIF CHECK_LOWER("ベビードール", ARG)
				RESULTS = 裾
			ELSEIF CHECK_LOWER("シャツ", ARG)
				RESULTS = 裾
			ELSEIF CHECK_LOWER("袴", ARG)
				RESULTS = 袴
			ELSEIF CHECK_LOWER("和服", ARG) || CHECK_LOWER("振袖", ARG) || CHECK_LOWER("着物", ARG) || CHECK_LOWER("浴衣", ARG)
				RESULTS = 裾
			ELSEIF CHECK_LOWER("巻きスカート", ARG)
				RESULTS = 腰布
			ELSEIF CHECK_LOWER("裾", ARG)
				RESULTS = 裾
			ELSEIF CHECK_LOWER("前垂れ", ARG)
				RESULTS = 前垂れ
			ELSE
				RESULTS = スカート
			ENDIF
			SIF CHECK_LOWER("オープン", ARG)
				RESULTS = "オープン"+RESULTS
		CASE "種類"
			SPLIT CSTR:ARG:下服, "/", RESULTS
			SIF CHECK_UPPER("巫女服", ARG)
				RESULTS = 緋袴
		CASE ""
			;RESULTS:0に名称、RESULTS:1～に色が入る場合がある
			SPLIT CSTR:ARG:下服, "/", RESULTS
			SIF CHECK_UPPER("巫女服", ARG)
				RESULTS = 緋袴
			RESULTS '= @"%CLOCOLOR(CSTR:ARG:下服, "形容詞")%%RESULTS%"
	ENDSELECT
	RETURNF RESULTS

