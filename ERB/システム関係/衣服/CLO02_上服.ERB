;ARGのシャツが条件ARGSを満たすか確認する
;-------------------------------------------------
@CHECK_UPPER(ARGS, ARG)
#FUNCTION
	SIF EQUIP:ARG:上服 == 0
		RETURNF 0
	SELECTCASE ARGS
		CASE "Ｙシャツ"
			SIF STRCOUNTS(CSTR:ARG:上服, "Ｙシャツ", "ワイシャツ")
				RETURNF 1
		CASE "ネクタイブレザー"
			SIF STRCOUNT(CSTR:ARG:上服, ARGS)
				RETURNF 1
			SIF STRCOUNT(CSTR:ARG:上服, "ブレザー") && CHECK_OTHER("ネクタイ", ARG)
				RETURNF 1
		CASE "ネクタイブラウス"
			SIF STRCOUNT(CSTR:ARG:上服, ARGS)
				RETURNF 1
			SIF STRCOUNT(CSTR:ARG:上服, "ブラウス") && CHECK_OTHER("ネクタイ", ARG)
				RETURNF 1
		CASE "はだけ可"
			SIF STRCOUNT(CSTR:ARG:上服, "はだけた")
				RETURNF 0
			SIF STRCOUNT(CSTR:ARG:上服, "はだけ不可")
				RETURNF 0
			RETURNF 1
		CASEELSE
			SIF STRCOUNT(CSTR:ARG:上服, ARGS)
				RETURNF 1
	ENDSELECT

	RETURNF 0

