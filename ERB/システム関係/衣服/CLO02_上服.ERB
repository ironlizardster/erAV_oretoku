;-------------------------------------------------
;キャラARGに服ARGSを着せる。ARGS == ""なら脱がす
;ワンピースor上下セット属性を持つ服はスカートも同時に設定する
;-------------------------------------------------
@SET_UPPER, ARGS, ARG
#DIMS MEMO_CLO
	MEMO_CLO = %CSTR:ARG:上服%
	;汚れ＆ずれたりしたフラグ等を初期化して新品にする	
	STAIN:ARG:上服 = 0

	CALL PALAM_UPPER, ARGS, ARG

	;コモンフラグを設定する
	CSTR:ARG:上服 = %SET_CLO_COMMON(CSTR:ARG:上服, ARG)%
	EQUIP:ARG:上服 = STRLENS(CSTR:ARG:上服)

	IF (CHECK_UPPER("ワンピース", ARG) || CHECK_LOWER("ズボンセット", ARG) || CHECK_UPPER("上下セット", ARG)) && CSTR:ARG:上服 != CSTR:ARG:下服
		CALL SET_LOWER, ARGS, ARG
	;服がワンピースじゃない場合にスカートがワンピースなのは脱がせ忘れなので、スカートを脱がす
	ELSEIF CHECK_LOWER("ワンピース", ARG) || CHECK_LOWER("ズボンセット", ARG) || CHECK_LOWER("上下セット", ARG)
		CALL SET_LOWER, "", ARG
	ENDIF
	SIF !TFLAG:着替えた && MEMO_CLO != CSTR:ARG:上服
		TFLAG:着替えた = 1

;-------------------------------------------------
;ARGのシャツの名前。ARGSに"略"と入れると略称になる
;-------------------------------------------------
@UPPER(ARG, ARGS)
#FUNCTIONS
	VARSET RESULTS
	SELECTCASE ARGS
		CASE "柄"
			SIF CHECK_UPPER("柄：", ARG) == 0
				RETURNF RESULTS
			RETURNF EXTSTR(CSTR:ARG:上服, "柄：", "/")
		CASE "略"
			IF CHECK_UPPER("鎧", ARG)
				RESULTS = 鎧
			ELSEIF CHECK_UPPER("セーター", ARG)
				RESULTS = セーター
			ELSEIF CHECK_UPPER("パジャマ", ARG)
				RESULTS = パジャマ
			ELSEIF CHECK_UPPER("ネグリジェ", ARG)
				RESULTS = ネグリジェ
			ELSEIF CHECK_UPPER("ベビードール", ARG)
				RESULTS = ベビードール
			ELSEIF CHECK_UPPER("ビスチェ", ARG)
				RESULTS = ビスチェ
			ELSEIF CHECK_UPPER("修道服", ARG)
				RESULTS = 修道服
			;ゴスロリドレスとサマードレスの略称はドレスで良いかも
			;ELSEIF CHECK_UPPER("ゴスロリドレス", ARG)
			;	RESULTS = ゴスロリドレス
			;ELSEIF CHECK_UPPER("サマードレス", ARG)
			;	RESULTS = サマードレス
			ELSEIF CHECK_UPPER("ドレス", ARG)
				RESULTS = ドレス
			ELSEIF CHECK_UPPER("巫女服", ARG)
				RESULTS = 白衣
			ELSEIF CHECK_UPPER("ブラウス", ARG)
				RESULTS = ブラウス
			ELSEIF CHECK_UPPER("ブレザー", ARG)
				RESULTS = ブレザー
			ELSEIF CHECK_UPPER("ベスト", ARG)
				RESULTS = ベスト
			ELSEIF CHECK_UPPER("セーラー", ARG)
				RESULTS = セーラー服
			ELSEIF CHECK_UPPER("チャイナドレス", ARG)
				RESULTS = チャイナドレス
			ELSEIF CHECK_UPPER("ナース服", ARG)
				RESULTS = ナース服
			ELSEIF CHECK_UPPER("体操服", ARG)
				RESULTS = 体操服
			ELSEIF CHECK_UPPER("執事服", ARG)
				RESULTS = 執事服
			ELSEIF CHECK_UPPER("メイド服", ARG)
				RESULTS = メイド服
			ELSEIF CHECK_UPPER("振袖", ARG)
				RESULTS = 振袖
			ELSEIF CHECK_UPPER("浴衣", ARG)
				RESULTS = 浴衣
			ELSEIF CHECK_UPPER("どてら", ARG)
				RESULTS = どてら
			ELSEIF CHECK_UPPER("着物", ARG)
				RESULTS = 着物
			ELSEIF CHECK_UPPER("キャミソール", ARG)
				RESULTS = キャミソール
			ELSEIF CHECK_UPPER("スーツ", ARG)
				RESULTS = スーツ
			ELSEIF CHECK_UPPER("Ｙシャツ", ARG)
				RESULTS = Ｙシャツ
			ELSEIF CHECK_UPPER("ワイシャツ", ARG)
				RESULTS = ワイシャツ
			ELSEIF CHECK_UPPER("Ｔシャツ", ARG)
				RESULTS = Ｔシャツ
			ELSEIF CHECK_UPPER("ウェイトレス", ARG)
				RESULTS = ウェイトレスの制服
			ELSEIF CHECK_UPPER("ジャージ", ARG)
				RESULTS = ジャージ
			ELSEIF CHECK_UPPER("アイドル衣装", ARG)
				RESULTS = アイドル衣装
			ELSEIF CHECK_UPPER("ローブ", ARG)
				RESULTS = ローブ
			ELSEIF CHECK_UPPER("サンタ服", ARG)
				RESULTS = サンタ服
			ELSEIF CHECK_UPPER("逆バニースーツ", ARG)
				RESULTS = 逆バニースーツ
			ELSE
				RESULTS = 服
			ENDIF
		CASE "種類"
			;RESULTS:0に名称が入る
			SPLIT CSTR:ARG:上服, "/", RESULTS
			SIF CHECK_UPPER("巫女服", ARG)
				RESULTS = 白衣
		CASE ""
			;RESULTS:0に名称が入る
			SPLIT CSTR:ARG:上服, "/", RESULTS
			SIF CHECK_UPPER("巫女服", ARG)
				RESULTS = 白衣
			RESULTS '= @"%CLOCOLOR(CSTR:ARG:上服, "形容詞")%%RESULTS%"
	ENDSELECT
	RETURNF RESULTS

