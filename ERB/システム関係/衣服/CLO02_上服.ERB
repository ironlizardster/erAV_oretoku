;-------------------------------------------------
;キャラARGに服ARGSを着せた場合のCSTR処理。ARGSは/で区切って追加属性をくっつける事も出来る
;例）CALL SET_UPPER, "シャツジャケット/緑色/腋露出" とすると、CSTR:ARG:上服 の末尾に本来の文字列に加えて 緑色/腋露出/ が追加される
;上下セットはコスプレや制服などの明らかに上下セットになってるもの以外は禁止
;-------------------------------------------------
@PALAM_UPPER, ARGS, ARG
;追加で記述された属性を一時的に保管する
#DIMS STR_ADD

	STR_ADD = %EXTSTR(ARGS, "/")%
	ARGS = %EXTSTR(ARGS, "", "/")%

	SELECTCASE ARGS
		CASE "", "無し"
			IF CHECK_UPPER("ワンピース", ARG) || CHECK_LOWER("ズボンセット", ARG) || CHECK_UPPER("上下セット", ARG)
				CSTR:ARG:下服 = 
				EQUIP:ARG:下服 = 0
			ENDIF
			CSTR:ARG:上服 = 
		CASE @"%CALLNAME:MASTER%のＹシャツ"
			IF TALENT:ARG:小柄
				CSTR:ARG:上服 = %CALLNAME:MASTER%のＹシャツ/ワンピース/
				CSTR:ARG:下服 = 裾/ワンピース/ミニ/
			ELSE
				CSTR:ARG:上服 = %CALLNAME:MASTER%のＹシャツ/
			ENDIF

		;コスプレ
		CASE "メイド服"
			CSTR:ARG:上服 = メイド服/ワンピース/
			CSTR:ARG:下服 = エプロンスカート/ロング/フリル/ワンピース/
		CASE "ミニスカメイド"
			CSTR:ARG:上服 = ミニスカメイド/メイド服/ワンピース/
			CSTR:ARG:下服 = エプロンスカート/ミニスカ/フリル/ワンピース/
		CASE "フレンチメイド"
			CSTR:ARG:上服 = フレンチメイド/上下セット/腋露出/メイド服/フリル/
			CSTR:ARG:下服 = エプロンスカート/超ミニスカ/フリル/ワンピース/
		CASE "エプロン"
			CSTR:ARG:上服 = エプロン/ワンピース/
			CSTR:ARG:下服 = 裾/エプロン/ミニスカ/フリル/ワンピース/
		CASE "ナース服"
			CSTR:ARG:上服 = ナース服/ワンピース/
			CSTR:ARG:下服 = スカート/ミニ/ワンピース/
		CASE "チャイナドレス"
			CSTR:ARG:上服 = チャイナドレス/腋露出/ワンピース/
			CSTR:ARG:下服 = 前垂れ/タイト/スリット/ワンピース/
		CASE "胸開きチャイナドレス"
			CSTR:ARG:上服 = 胸開きチャイナドレス/腋露出/ワンピース/谷間露出/
			CSTR:ARG:下服 = 前垂れ/タイト/スリット/ワンピース/
		CASE "巫女服"
			CSTR:ARG:上服 = 巫女服/上下セット/
			CSTR:ARG:下服 = 緋袴/
		CASE "ミニスカ巫女"
			CSTR:ARG:上服 = ミニスカ巫女服/上下セット/
			CSTR:ARG:下服 = ミニスカート/
		CASE "腋巫女"
			CSTR:ARG:上服 = 腋巫女/巫女服/上下セット/腋露出/
			CSTR:ARG:下服 = マイクロミニスカート/超ミニ/
		CASE "ウェディングドレス"
			CSTR:ARG:上服 = ウェディングドレス/ワンピース/谷間露出/
			CSTR:ARG:下服 = ヒップボーンスカート/ロング/ワンピース/
		CASE "チアユニフォーム"
			CSTR:ARG:上服 = チアユニフォーム/上下セット/腋露出/要たくし上げ/
			CSTR:ARG:下服 = ミニスカート/プリーツ/
		CASE "修道服"
			CSTR:ARG:上服 = 修道服/ワンピース/要たくし上げ/
			CSTR:ARG:下服 = ロングスカート/ワンピース/
		CASE "ゴスロリドレス"
			CSTR:ARG:上服 = ゴスロリドレス/上下セット/
			CSTR:ARG:下服 = スカート/
		CASE "アイドル衣装"
			CSTR:ARG:上服 = アイドル衣装/上下セット/
			CSTR:ARG:下服 = スカート/
		CASE "ベビードール"
			CSTR:ARG:上服 = ベビードール/ワンピース/腋露出/シースルー/要たくし上げ/ランジェリー/
			CSTR:ARG:下服 = 裾/超ミニ/ベビードール/シースルー/ワンピース/
		CASE "ネグリジェ"
			CSTR:ARG:上服 = ネグリジェ/ワンピース/腋露出/シースルー/要たくし上げ/
			CSTR:ARG:下服 = 裾/シースルー/ワンピース/
		CASE "パジャマ"
			CSTR:ARG:上服 = パジャマ/
		CASE "サンタ服"
			CSTR:ARG:上服 = サンタ服/ワンピース/
			CSTR:ARG:下服 = スカート/ワンピース/
		CASE "逆バニースーツ"
			CSTR:ARG:上服 = 逆バニースーツ/乳房露出/谷間露出/脇露出/へそ露出/はだけ不可/

		;和装
		CASE "和服"
			CSTR:ARG:上服 = 和服/ワンピース/着物/
			CSTR:ARG:下服 = 裾/ワンピース/着物/
		CASE "振袖"
			CSTR:ARG:上服 = 振袖/ワンピース/着物/
			CSTR:ARG:下服 = 裾/振袖/ワンピース/着物/
		CASE "浴衣"
			CSTR:ARG:上服 = 浴衣/ワンピース/
			CSTR:ARG:下服 = 裾/浴衣/ワンピース/
		CASE "どてら"
			CSTR:ARG:上服 = どてら/ワンピース/
			CSTR:ARG:下服 = 裾/ワンピース/

		;制服
		CASE "セーラー服"
			IF COND("夏", ARG)
				CSTR:ARG:上服 = セーラー服/セーラー夏服/上下セット/要たくし上げ/へそ露出/汗透け/
			ELSE
				CSTR:ARG:上服 = セーラー服/上下セット/要たくし上げ/
			ENDIF
			CSTR:ARG:下服 = プリーツスカート/
		CASE "ミニスカセーラー服"
			CSTR:ARG:上服 = セーラー服/上下セット/要たくし上げ/
			CSTR:ARG:下服 = プリーツミニスカート/
		CASE "ミニマムセーラー服"
			CSTR:ARG:上服 = ミニマムセーラー服/上下セット/要たくし上げ/腋露出/へそ露出/汗透け/
			CSTR:ARG:下服 = マイクロプリーツスカート/超ミニ/
		CASE "ノースリーブセーラー服"
			CSTR:ARG:上服 = ノースリーブセーラー服/上下セット/要たくし上げ/腋露出/汗透け/
			CSTR:ARG:下服 = プリーツスカート/
		;萌え袖オプションがあります
		CASE "カーディガン"
			CSTR:ARG:上服 = カーディガン/上下セット/
			CSTR:ARG:下服 = チェックスカート/
		CASE "ミニスカカーディガン"
			CSTR:ARG:上服 = カーディガン/上下セット/
			CSTR:ARG:下服 = チェックミニスカート/
		CASE "萌え袖カーディガン"
			CSTR:ARG:上服 = カーディガン/上下セット/萌え袖/
			CSTR:ARG:下服 = チェックスカート/

		CASE "ブレザー"
			CSTR:ARG:上服 = ブレザー/上下セット/
			CSTR:ARG:下服 = チェックスカート/
		CASE "リボンタイブレザー"
			CSTR:ARG:上服 = リボンタイブレザー/上下セット/
			CSTR:ARG:下服 = チェックスカート/
		CASE "ネクタイブレザー"
			CSTR:ARG:上服 = ネクタイブレザー/上下セット/
			CSTR:ARG:下服 = チェックスカート/
		CASE "ミニスカブレザー"
			CSTR:ARG:上服 = ブレザー/上下セット/
			CSTR:ARG:下服 = チェックミニスカート/
		CASE "アメスク"
			CSTR:ARG:上服 = ルーズブラウス/谷間露出/汗透け/へそ露出/上下セット/アメスク/
			CSTR:ARG:下服 = マイクロチェックスカート/超ミニ/
		CASE "学ラン"
			CSTR:ARG:上服 = 学ラン/男物/ズボンセット/
			CSTR:ARG:アウター = 学生ズボン/ずれ不可/コキ不可/ズボン/男物/社会の窓/ロングパンツ/
		CASE "男子ブレザー"
			CSTR:ARG:上服 = ネクタイブレザー/男物/ズボンセット/
			CSTR:ARG:アウター = スラックス/ずれ不可/コキ不可/ズボン/男物/社会の窓/ロングパンツ/
		CASE "シャツジャケット"
			CSTR:ARG:上服 = シャツジャケット/男物/
		CASE "前開きシャツ"
			CSTR:ARG:上服 = 前開きシャツ/谷間露出/汗透け/
		CASE "ベスト"
			CSTR:ARG:上服 = ベスト/
		CASE "男子ベスト"
			CSTR:ARG:上服 = ベスト/男物/

		;体操服
		CASE "体操服"
			CSTR:ARG:上服 = 体操服/要たくし上げ/%CLOCOLOR_MAIDFACE("体操服", "", ARG)%/
		CASE "体操服(短)", "体操服（短）"
			CSTR:ARG:上服 = 体操服(短)/要たくし上げ/へそ露出/%CLOCOLOR_MAIDFACE("体操服", "", ARG)%/
		CASE "ジャージ"
			CSTR:ARG:上服 = ジャージ/%CLOCOLOR_MAIDFACE("ジャージ", "", ARG)%/
		CASE "詰襟ジャージ"
			CSTR:ARG:上服 = 詰襟ジャージ/

		;普段着など
		CASE "ブラウス"
			CSTR:ARG:上服 = ブラウス/汗透け/
		CASE "へそ出しブラウス"
			CSTR:ARG:上服 = ブラウス/汗透け/へそ露出/
		CASE "ネクタイブラウス"
			CSTR:ARG:上服 = ネクタイブラウス/汗透け/
			CSTR:ARG:下服 = チェックスカート/
		CASE "リボンタイブラウス"
			CSTR:ARG:上服 = リボンタイブラウス/汗透け/
			CSTR:ARG:下服 = チェックスカート/
		CASE "ノースリーブ", "ノースリーブブラウス"
			CSTR:ARG:上服 = ノースリーブブラウス/汗透け/腋露出/
		CASE "ノースリーブＢ", "ノースリーブブラウスＢ"
			CSTR:ARG:上服 = ノースリーブブラウスＢ/汗透け/腋露出/
		CASE "ネクタイノースリーブブラウス"
			CSTR:ARG:上服 = ノースリーブブラウス/汗透け/腋露出/ネクタイ/

