;-------------------------------------------------
;色セット関数@GET_COLOR_CODE
;-------------------------------------------------
@GET_COLOR_CODE, ARGS
#FUNCTION
	;LOCALに色を代入
	SELECTCASE ARGS
		CASE "濃赤"
			RESULT:1 = 0x701000
			RESULT = 0xF06050
		CASE "紺"
			RESULT:1 = 0x000000
			RESULT = 0x6666FF
		CASE "黄"
			RESULT:1 = 0x505020
			RESULT = 0xC0B050
		CASE "桃"
			RESULT:1 = 0x300020
			RESULT = 0xFFCCFF
		CASE "灰"
			RESULT:1 = 0x333333
			RESULT = 0x666666
		CASE "赤"
			RESULT:1 = 0x502020
			RESULT = 0xC07070
		CASE "薄赤"
			RESULT:1 = 0x803040
			RESULT = 0xF07090
		CASE "青"
			RESULT:1 = 0x202050
			RESULT = 0x7070C0
		CASE "緑"
			RESULT:1 = 0x205020
			RESULT = 0x70C070
		CASE "紫"
			RESULT:1 = 0x502050
			RESULT = 0xC070C0
		CASE "黄色"
			RESULT:1 = 0x505020
			RESULT = 0xC0C070
		CASE "青緑"
			RESULT:1 = 0x205050
			RESULT = 0x70C0C0
		CASE "白"
			RESULT:1 = 0x202020
			RESULT = 0xC0C0C0
		CASE "オレンジ"
			RESULT:1 = 0x504010
			RESULT = 0xFF8000
		CASE "水色"
			RESULT:1 = 0x203030
			RESULT = 0x5090FF
		CASE "EXTRA"
			RESULT:1 = 0x505020
			RESULT = 0xFFFFDD
		CASE "EXTRA2"
			RESULT:1 = 0x505020
			RESULT = 0xFFFFDD
		;白
		CASEELSE
			RESULT:1 = 0x202020
			RESULT =  0xCCFFCC
	ENDSELECT
	RETURNF RESULT

;-------------------------------------------------
;ハートマーク関数@HEART
;	引数0：ハートの数（省略すると1つ）
;	引数1：使用するフォント名（省略するとVerdana）
;中抜きのハートマークを表示します
;-------------------------------------------------
@HEART(ARG = 1, ARGS)
	LOCALS = %GETFONT()%
	SETFONT "Times New Roman"
	PRINTFORM %UNICODE(0x2665)*ARG%
	SETFONT LOCALS

;ハート文字を返す
;フォントは考慮していない
@GET_HEART()
#FUNCTIONS
	RESULTS = UNICODE(0x2665)
	RETURNF RESULTS

;ハート文字で挟む
@CLIP_HEART(文字列)
#FUNCTIONS
#DIMS 文字列
	RESULTS = %GET_HEART() + 文字列 + GET_HEART()%
	RETURNF RESULTS
